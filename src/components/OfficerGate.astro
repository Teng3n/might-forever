<section class="officer-gate-shell" data-officer-gate hidden>
  <div class="panel officer-gate-modal" role="dialog" aria-modal="true" aria-labelledby="officer-access-title">
    <div class="section-heading">
      <p class="eyebrow">Officer Access</p>
      <h2 id="officer-access-title">Officer Access</h2>
      <p class="info-note">Enter the officer password to continue.</p>
    </div>

    <form class="officer-gate-form" data-officer-gate-form>
      <label class="field">
        <span>Password</span>
        <input type="password" name="password" autocomplete="current-password" required autofocus />
      </label>
      <button class="filter-button is-subtle" type="submit">Unlock</button>
    </form>

    <p class="info-note officer-gate-status" data-officer-gate-status aria-live="polite"></p>
  </div>
</section>

<div class="officer-gated-content" data-officer-gated-content hidden aria-live="polite">
  <slot />
</div>

<script>
  const OFFICER_UNLOCKED_KEY = "officerUnlocked";
  const LEGACY_OFFICER_UNLOCKED_KEY = "vitalityOfficerUnlocked";
  const officerGate = document.querySelector<HTMLElement>("[data-officer-gate]");
  const officerContent = document.querySelector<HTMLElement>("[data-officer-gated-content]");
  const officerGateForm = document.querySelector<HTMLFormElement>("[data-officer-gate-form]");
  const officerGateStatus = document.querySelector<HTMLElement>("[data-officer-gate-status]");

  const showOfficerGate = () => {
    if (officerContent) {
      officerContent.hidden = true;
    }

    if (officerGate) {
      officerGate.hidden = false;
    }

    window.setTimeout(() => {
      window.dispatchEvent(new CustomEvent("might:officer-locked"));
    }, 0);
  };

  const showOfficerContent = () => {
    if (officerGate) {
      officerGate.hidden = true;
    }

    if (officerContent) {
      officerContent.hidden = false;
    }

    window.setTimeout(() => {
      window.dispatchEvent(new CustomEvent("might:officer-unlocked"));
    }, 0);
  };

  const hasStoredOfficerUnlock = () => {
    try {
      return (
        sessionStorage.getItem(OFFICER_UNLOCKED_KEY) === "true" ||
        sessionStorage.getItem(LEGACY_OFFICER_UNLOCKED_KEY) === "true"
      );
    } catch {
      return false;
    }
  };

  const rememberOfficerUnlock = () => {
    try {
      sessionStorage.setItem(OFFICER_UNLOCKED_KEY, "true");
      sessionStorage.removeItem(LEGACY_OFFICER_UNLOCKED_KEY);
    } catch {
      // The HttpOnly session cookie still handles server-side officer auth.
    }
  };

  const forgetOfficerUnlock = () => {
    try {
      sessionStorage.removeItem(OFFICER_UNLOCKED_KEY);
      sessionStorage.removeItem(LEGACY_OFFICER_UNLOCKED_KEY);
    } catch {
      // Nothing else to do. The form remains usable.
    }
  };

  const verifyStoredOfficerUnlock = async () => {
    if (!hasStoredOfficerUnlock()) {
      showOfficerGate();
      return;
    }

    showOfficerContent();

    try {
      const response = await fetch("/api/officer-auth", { method: "GET" });
      const result = (await response.json()) as { ok?: boolean };

      if (response.ok && result.ok === true) {
        rememberOfficerUnlock();
        return;
      }
    } catch {
      // Fall through to showing the modal.
    }

    forgetOfficerUnlock();
    showOfficerGate();
  };

  void verifyStoredOfficerUnlock();

  officerGateForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const submitButton = officerGateForm.querySelector<HTMLButtonElement>("button[type='submit']");
    const formData = new FormData(officerGateForm);
    const password = String(formData.get("password") ?? "");

    if (!password) {
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Unlocking...";
    }

    if (officerGateStatus) {
      officerGateStatus.textContent = "";
      officerGateStatus.dataset.state = "";
    }

    try {
      const response = await fetch("/api/officer-auth", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ password }),
      });
      const responseText = await response.text();
      let result: { ok?: boolean; message?: string } | undefined;

      if (responseText) {
        try {
          result = JSON.parse(responseText) as { ok?: boolean; message?: string };
        } catch {
          result = undefined;
        }
      }

      if (!response.ok || result?.ok !== true) {
        if (officerGateStatus) {
          officerGateStatus.textContent = result?.message ?? "Unable to verify officer access.";
          officerGateStatus.dataset.state = "error";
        }
        return;
      }

      rememberOfficerUnlock();
      officerGateForm.reset();
      showOfficerContent();
    } catch {
      if (officerGateStatus) {
        officerGateStatus.textContent = "Unable to verify officer access.";
        officerGateStatus.dataset.state = "error";
      }
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Unlock";
      }
    }
  });
</script>
