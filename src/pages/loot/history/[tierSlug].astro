---
import Layout from "../../../layouts/Layout.astro";
import DataTable from "../../../components/DataTable.astro";
import LootTierNav from "../../../components/LootTierNav.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { getLootAwardsForTier, lootTiers, type LootTier } from "../../../lib/lootTiers";

export const getStaticPaths = () =>
  lootTiers.map((tier) => ({
    params: { tierSlug: tier.slug },
    props: { activeTier: tier },
  }));

const { activeTier } = Astro.props as { activeTier: LootTier };
const rows = getLootAwardsForTier(activeTier.slug).map((award) => ({
  date: award.date,
  player: award.player,
  item: award.item,
  boss: award.boss,
  instance: award.instance,
  type: award.type,
}));
const columns = [
  { key: "date", label: "Date" },
  { key: "player", label: "Player" },
  { key: "item", label: "Item" },
  { key: "boss", label: "Boss" },
  { key: "instance", label: "Instance" },
  { key: "type", label: "Response / Type" },
];
---

<Layout title={`Loot History | ${activeTier.label} | Might Forever`}>
  <PageHeader
    eyebrow="Loot History"
    title={`${activeTier.label} Award Log`}
  />

  <LootTierNav activeTier={activeTier} view="history" />

  <section class="panel">
    <div class="toolbar">
      <label class="field">
        <span>Search history</span>
        <input type="search" data-history-search placeholder="Search player, item, boss, instance, response" />
      </label>
      <span class="muted" data-history-count>{rows.length} rows</span>
    </div>
    <DataTable columns={columns} rows={rows} tableClass="loot-history-table" cellTitle={true} />
  </section>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>("[data-history-search]");
    const countLabel = document.querySelector<HTMLElement>("[data-history-count]");
    const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-search]"));

    searchInput?.addEventListener("input", () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      for (const row of rows) {
        const matches = row.dataset.search?.includes(query) ?? false;
        row.hidden = !matches;
        if (matches) {
          visibleCount += 1;
        }
      }

      if (countLabel) {
        countLabel.textContent = `${visibleCount} rows`;
      }
    });
  </script>
</Layout>
