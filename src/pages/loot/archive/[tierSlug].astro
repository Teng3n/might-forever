---
import Layout from "../../../layouts/Layout.astro";
import DataTable from "../../../components/DataTable.astro";
import LootTierNav from "../../../components/LootTierNav.astro";
import PageHeader from "../../../components/PageHeader.astro";
import StatCard from "../../../components/StatCard.astro";
import { activeRosterPlayers } from "../../../lib/guildData";
import { getLootSummaryForTier, lootTiers, type LootTier } from "../../../lib/lootTiers";

export const getStaticPaths = () =>
  lootTiers.map((tier) => ({
    params: { tierSlug: tier.slug },
    props: { activeTier: tier },
  }));

const { activeTier } = Astro.props as { activeTier: LootTier };
const summaryRows = getLootSummaryForTier(activeTier.slug);
const rows: Record<string, unknown>[] = summaryRows.map((row) => ({ ...row }));
const activeRows = summaryRows.filter((row) => row.activeRoster);
const activeCountedAwards = activeRows.reduce((sum, row) => sum + row.total, 0);
const allCountedAwards = summaryRows.reduce((sum, row) => sum + row.total, 0);
const columns = [
  { key: "player", label: "Player", sortable: true, sortType: "text" },
  { key: "bis", label: "BiS", align: "right", sortable: true, sortType: "number" },
  { key: "major", label: "Major", align: "right", sortable: true, sortType: "number" },
  { key: "minor", label: "Minor", align: "right", sortable: true, sortType: "number" },
  { key: "offspec", label: "Offspec", align: "right", sortable: true, sortType: "number" },
  { key: "bonusRolls", label: "Bonus Rolls", align: "right", sortable: true, sortType: "number" },
  { key: "total", label: "Total", align: "right", sortable: true, sortType: "number" },
] satisfies Array<{ key: string; label: string; align?: "left" | "center" | "right"; sortable?: boolean; sortType?: "text" | "number" }>;

---

<Layout title={`Loot Summary | ${activeTier.label} | Might Forever`}>
  <PageHeader
    eyebrow="Loot Summary"
    title={`${activeTier.label} Loot Summary`}
  />

  <LootTierNav activeTier={activeTier} view="summary" />

  <section class="dashboard-grid compact">
    <StatCard label="Active roster players" value={activeRosterPlayers.length} detail="Current roster" />
    <article class="stat-card">
      <span>Visible loot recipients</span>
      <strong data-visible-loot-recipients>{activeRows.length}</strong>
      <small>Current table view</small>
    </article>
    <article class="stat-card">
      <span>Counted awards</span>
      <strong data-visible-counted-awards>{activeCountedAwards}</strong>
      <small>BiS, major, and minor</small>
    </article>
  </section>

  <section class="panel" data-loot-summary-panel data-active-counted-awards={activeCountedAwards} data-all-counted-awards={allCountedAwards}>
    <div class="toolbar">
      <label class="check-field">
        <input type="checkbox" data-include-all-loot />
        <span>Include historical loot recipients</span>
      </label>
      <span class="muted" data-loot-summary-count>
        Totals include BiS, Major, and Minor. Offspec and Bonus Rolls are shown separately.
      </span>
    </div>
    <DataTable
      columns={columns}
      rows={rows}
      initialSortKey="player"
      initialSortDirection="ascending"
      tableClass="loot-summary-table"
    />
  </section>

  <script>
    const includeAllLoot = document.querySelector<HTMLInputElement>("[data-include-all-loot]");
    const visibleRecipientCount = document.querySelector<HTMLElement>("[data-visible-loot-recipients]");
    const visibleCountedAwards = document.querySelector<HTMLElement>("[data-visible-counted-awards]");
    const lootSummaryPanel = document.querySelector<HTMLElement>("[data-loot-summary-panel]");
    const lootRows = Array.from(document.querySelectorAll<HTMLTableRowElement>(".loot-summary-table tbody tr[data-active-roster]"));
    const activeCountedAwards = Number(lootSummaryPanel?.dataset.activeCountedAwards ?? 0);
    const allCountedAwards = Number(lootSummaryPanel?.dataset.allCountedAwards ?? 0);

    const updateLootRows = () => {
      const showAll = includeAllLoot?.checked ?? false;
      let count = 0;

      for (const row of lootRows) {
        const hidden = !showAll && row.dataset.activeRoster === "false";
        row.hidden = hidden;

        if (!hidden) {
          count += 1;
        }
      }

      if (visibleRecipientCount) {
        visibleRecipientCount.textContent = String(count);
      }

      if (visibleCountedAwards) {
        visibleCountedAwards.textContent = String(showAll ? allCountedAwards : activeCountedAwards);
      }
    };

    includeAllLoot?.addEventListener("change", updateLootRows);
    updateLootRows();
  </script>
</Layout>
