---
import Layout from "../layouts/Layout.astro";
import NextRaidCard from "../components/NextRaidCard.astro";
import PageHeader from "../components/PageHeader.astro";
import UpcomingRaidWeeks from "../components/UpcomingRaidWeeks.astro";
import calendar from "../data/calendar.json";

const calendarData = calendar as unknown as {
  raidDates: Array<{ label: string; isoDate: string }>;
  summary: Array<{ label: string; values: Record<string, string> }>;
  players: Array<{
    name: string;
    bis: number;
    major: number;
    minor: number;
    total: number;
    bonusRolls: number;
    offspec: number;
    mia: number;
    out: number;
    late: number;
    bench: number;
    schedule: Record<string, string>;
  }>;
};
---

<Layout title="Raider Dashboard | Might Forever">
  <PageHeader
    eyebrow="Raid Dashboard"
    title="Raider Dashboard"
  />

  <NextRaidCard calendar={calendarData} />

  <UpcomingRaidWeeks eyebrow="Upcoming Raid Nights" title="Next Two Weeks" startOffset={1} weekCount={2} />

  <UpcomingRaidWeeks eyebrow="Upcoming Raid Nights" title="Looking Ahead" startOffset={3} weekCount={2} />
</Layout>
