---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import RaidWindow from "../components/RaidWindow.astro";
import { calendarDataRaw } from "../lib/guildData";
---

<Layout title="Raid Calendar | Might Forever">
  <PageHeader
    eyebrow="Raid Calendar"
    title="Raid Calendar"
  />

  <RaidWindow
    calendar={calendarDataRaw}
    summaryStrategy="raid-week"
    showSummaryCards={false}
    showDateRangeControls={true}
    windowSize={12}
    eyebrow="Current Calendar Snapshot"
    title="Upcoming Raid Weeks"
  />
</Layout>
