---
import Layout from "../../layouts/Layout.astro";

const schemes = [
  {
    id: "mop-indigo",
    name: "MoP Gold · Might Indigo",
    detail: "The exact current Might Forever blue replacing jade—the closest bridge between both sites.",
    colors: ["#0B0D18", "#C89B3C", "#7C8CFF", "#F2F0E8"],
    family: "mop-blue",
    background: "#0B0D18",
    surface: "#121629",
    surfaceStrong: "#19203A",
    border: "#303B63",
    secondary: "#7C8CFF",
    emphasis: "#C89B3C",
  },
  {
    id: "mop-cobalt",
    name: "MoP Gold · Cobalt",
    detail: "A saturated mid-blue with more authority and less purple than the current Might accent.",
    colors: ["#090D18", "#C89B3C", "#5B7CFA", "#F2F0E8"],
    family: "mop-blue",
    background: "#090D18",
    surface: "#10172A",
    surfaceStrong: "#17213D",
    border: "#2C3C68",
    secondary: "#5B7CFA",
    emphasis: "#C89B3C",
  },
  {
    id: "mop-periwinkle",
    name: "MoP Gold · Periwinkle",
    detail: "A softer blue-violet that echoes Might Forever without overwhelming the warmer gold.",
    colors: ["#0C0F1A", "#C89B3C", "#8EA0FF", "#F2F0E8"],
    family: "mop-blue",
    background: "#0C0F1A",
    surface: "#14192B",
    surfaceStrong: "#1C233E",
    border: "#374266",
    secondary: "#8EA0FF",
    emphasis: "#C89B3C",
  },
  {
    id: "mop-royal",
    name: "MoP Gold · Royal Blue",
    detail: "A deeper blue-violet with stronger guild-banner character and a more dramatic mood.",
    colors: ["#0A0B18", "#C89B3C", "#6670E8", "#F2F0E8"],
    family: "mop-blue",
    background: "#0A0B18",
    surface: "#111329",
    surfaceStrong: "#181B3A",
    border: "#30345F",
    secondary: "#6670E8",
    emphasis: "#C89B3C",
  },
];

const initialScheme = schemes[0];
---

<Layout title="Might Forever Color Lab">
  <div
    class="color-lab"
    data-color-lab
    data-family={initialScheme.family}
    style={`--preview-bg: ${initialScheme.background}; --preview-surface: ${initialScheme.surface}; --preview-surface-strong: ${initialScheme.surfaceStrong}; --preview-border: ${initialScheme.border}; --preview-accent-two: ${initialScheme.secondary}; --preview-emphasis: ${initialScheme.emphasis}`}
  >
    <header class="color-lab-heading">
      <p class="eyebrow">Might Forever design study</p>
      <h1>MoP gold, Might blue</h1>
      <p>The exact Vitality MoP palette, with jade replaced by four finalist variations of Might Forever blue.</p>
    </header>

    <div class="palette-tabs" role="group" aria-label="Blue accent variation">
      {
        schemes.map((scheme, index) => (
          <button
            type="button"
            data-palette-button={scheme.id}
            data-family={scheme.family}
            data-background={scheme.background}
            data-surface={scheme.surface}
            data-surface-strong={scheme.surfaceStrong}
            data-border={scheme.border}
            data-secondary={scheme.secondary}
            data-emphasis={scheme.emphasis}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{scheme.name}</strong>
            <small>{scheme.detail}</small>
            <i aria-hidden="true">
              {scheme.colors.map((color) => <b style={`background: ${color}`}></b>)}
            </i>
          </button>
        ))
      }
    </div>

    <section class="concept" aria-label="Selected Might Forever theme preview">
      <aside class="concept-nav">
        <strong>Might Forever</strong>
        <nav>
          <span>Home</span>
          <span class="is-active">Roster</span>
          <small>Guild Archive</small>
          <span>Officer</span>
        </nav>
      </aside>

      <div class="concept-body">
        <header class="concept-hero">
          <p>Roster · Classic Vanilla to today</p>
          <h2>Roster Guild Archive</h2>
          <span>A person-level history built from actual Warcraft Logs attendance.</span>
        </header>

        <div class="concept-stats">
          <article><span>Unique Raiders</span><strong>881</strong><small>Conservative person groups</small></article>
          <article><span>Logged Characters</span><strong>1,008</strong><small>All had raid attendance</small></article>
          <article><span>Alt Groups</span><strong>51</strong><small>Profiles with 2+ characters</small></article>
          <article><span>Years Covered</span><strong>2020–2026</strong><small>Classic Vanilla through MoP</small></article>
        </div>

        <section class="concept-panel">
          <div class="concept-panel-heading">
            <div><p>Find a raider</p><h3>Filter the full archive</h3></div>
            <span>Reset filters</span>
          </div>
          <div class="concept-search">Search people or character names</div>
          <div class="concept-filters">
            <b>Expansion</b>
            <span class="is-active">All</span><span>Classic</span><span>TBC</span><span>Wrath</span><span>Cataclysm</span><span>MoP</span>
          </div>
        </section>

        <div class="concept-rows">
          <article><i>T</i><div><strong>Tengen</strong><span>Warrior · 7 logged characters</span></div><small>Last logged raid<br /><b>Sep 21, 2026</b></small></article>
          <article><i>K</i><div><strong>Karkan</strong><span>Paladin · 4 logged characters</span></div><small>Last logged raid<br /><b>Sep 14, 2026</b></small></article>
          <article><i>S</i><div><strong>Stim</strong><span>Priest · 3 logged characters</span></div><small>Last logged raid<br /><b>Aug 31, 2026</b></small></article>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const colorLab = document.querySelector<HTMLElement>("[data-color-lab]");
  if (colorLab) {
    const buttons = [...colorLab.querySelectorAll<HTMLButtonElement>("[data-palette-button]")];
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        colorLab.dataset.family = button.dataset.family;
        colorLab.style.setProperty("--preview-bg", button.dataset.background ?? "#0b0d18");
        colorLab.style.setProperty("--preview-surface", button.dataset.surface ?? "#121629");
        colorLab.style.setProperty("--preview-surface-strong", button.dataset.surfaceStrong ?? "#19203a");
        colorLab.style.setProperty("--preview-border", button.dataset.border ?? "#303b63");
        colorLab.style.setProperty("--preview-accent-two", button.dataset.secondary ?? "#7c8cff");
        colorLab.style.setProperty("--preview-emphasis", button.dataset.emphasis ?? "#c89b3c");
        buttons.forEach((candidate) =>
          candidate.setAttribute("aria-pressed", String(candidate === button)),
        );
      });
    });
  }
</script>

<style>
  .color-lab {
    --preview-bg: #0b0d18;
    --preview-surface: #121629;
    --preview-surface-strong: #19203a;
    --preview-border: #303b63;
    --preview-text: #f2f0e8;
    --preview-muted: #aeb8ad;
    --preview-accent: #c89b3c;
    --preview-accent-two: #7c8cff;
    display: grid;
    gap: 24px;
  }

  .color-lab-heading h1 {
    max-width: 780px;
    margin: 8px 0 10px;
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .color-lab-heading > p:last-child {
    margin: 0;
    color: var(--muted);
  }

  .palette-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .palette-tabs button {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px 9px;
    align-content: start;
    min-height: 150px;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    background: var(--surface);
    color: var(--text);
    text-align: left;
    cursor: pointer;
  }

  .palette-tabs button:hover,
  .palette-tabs button:focus-visible,
  .palette-tabs button[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--surface-strong);
    outline: none;
  }

  .palette-tabs button > span {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 900;
  }

  .palette-tabs strong {
    font-size: 0.9rem;
  }

  .palette-tabs small {
    grid-column: 1 / -1;
    color: var(--muted);
    line-height: 1.45;
  }

  .palette-tabs i {
    grid-column: 1 / -1;
    display: flex;
    gap: 5px;
    align-self: end;
    margin-top: 6px;
  }

  .palette-tabs i b {
    width: 24px;
    height: 8px;
    border-radius: 999px;
  }

  .concept {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    min-height: 720px;
    overflow: hidden;
    border: 1px solid var(--preview-border);
    border-radius: 14px;
    background: var(--preview-bg);
    color: var(--preview-text);
    box-shadow: var(--shadow);
    transition: background 180ms ease, border-color 180ms ease;
  }

  .concept-nav {
    display: grid;
    align-content: start;
    gap: 24px;
    padding: 30px 16px;
    background: var(--preview-surface);
  }

  .concept-nav > strong {
    color: var(--preview-emphasis);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .concept-nav nav {
    display: grid;
    gap: 4px;
  }

  .concept-nav nav > * {
    border-left: 2px solid transparent;
    padding: 7px 8px;
    color: var(--preview-muted);
    font-size: 0.78rem;
  }

  .concept-nav nav .is-active {
    border-color: var(--preview-accent);
    color: var(--preview-text);
  }

  .concept-nav nav small {
    padding-left: 18px;
    color: var(--preview-accent);
    font-weight: 850;
  }

  .concept-body {
    display: grid;
    align-content: start;
    gap: 18px;
    min-width: 0;
    padding: 24px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--preview-accent-two) 8%, transparent), transparent 300px);
  }

  .concept-hero {
    min-height: 230px;
    border: 1px solid color-mix(in srgb, var(--preview-accent) 38%, transparent);
    border-radius: 12px;
    padding: 34px;
    background:
      radial-gradient(circle at 88% 16%, color-mix(in srgb, var(--preview-accent-two) 24%, transparent), transparent 25rem),
      linear-gradient(135deg, color-mix(in srgb, var(--preview-accent) 18%, transparent), transparent 56%),
      var(--preview-surface);
  }

  .concept-hero p,
  .concept-panel-heading p {
    margin: 0;
    color: var(--preview-emphasis);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .concept-hero h2 {
    max-width: 720px;
    margin: 12px 0 16px;
    font-size: clamp(2.8rem, 7vw, 4.75rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .concept-hero > span {
    color: var(--preview-muted);
  }

  .concept-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .concept-stats article {
    display: grid;
    gap: 6px;
    border: 1px solid var(--preview-border);
    border-radius: 9px;
    padding: 14px;
    background: var(--preview-surface);
  }

  .concept-stats span,
  .concept-stats small {
    color: var(--preview-muted);
    font-size: 0.66rem;
  }

  .concept-stats strong {
    color: var(--preview-emphasis);
    font-size: 1.3rem;
  }

  .concept-panel {
    display: grid;
    gap: 14px;
    border: 1px solid var(--preview-border);
    border-radius: 10px;
    padding: 18px;
    background: var(--preview-surface);
  }

  .concept-panel-heading {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .concept-panel-heading h3 {
    margin: 4px 0 0;
  }

  .concept-panel-heading > span {
    color: var(--preview-muted);
    font-size: 0.7rem;
    text-decoration: underline;
  }

  .concept-search {
    border: 1px solid var(--preview-border);
    border-radius: 7px;
    padding: 12px;
    background: var(--preview-bg);
    color: var(--preview-muted);
    font-size: 0.76rem;
  }

  .concept-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
  }

  .concept-filters b {
    width: 100%;
    color: var(--preview-muted);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .concept-filters span {
    border: 1px solid var(--preview-border);
    border-radius: 999px;
    padding: 6px 10px;
    color: var(--preview-muted);
    font-size: 0.72rem;
  }

  .concept-filters .is-active {
    border-color: var(--preview-accent);
    background: color-mix(in srgb, var(--preview-accent) 14%, transparent);
    color: var(--preview-emphasis);
  }

  .concept-rows {
    display: grid;
    gap: 7px;
  }

  .concept-rows article {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    border: 1px solid var(--preview-border);
    border-radius: 8px;
    padding: 11px 13px;
    background: color-mix(in srgb, var(--preview-surface-strong) 88%, transparent);
  }

  .concept-rows i {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--preview-emphasis) 14%, transparent);
    color: var(--preview-emphasis);
    font-style: normal;
    font-weight: 900;
  }

  .concept-rows div {
    display: grid;
    gap: 3px;
  }

  .concept-rows div strong {
    color: var(--preview-emphasis);
  }

  .concept-rows div span,
  .concept-rows > article > small {
    color: var(--preview-muted);
    font-size: 0.7rem;
  }

  .concept-rows > article > small {
    text-align: right;
  }

  .concept-rows small b {
    color: var(--preview-text);
  }

  @media (max-width: 960px) {
    .palette-tabs,
    .concept-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .palette-tabs {
      grid-template-columns: 1fr;
    }

    .palette-tabs button {
      min-height: 0;
    }

    .concept {
      grid-template-columns: 1fr;
    }

    .concept-nav {
      display: none;
    }

    .concept-body {
      padding: 14px;
    }

    .concept-hero {
      min-height: 0;
      padding: 26px 20px;
    }

    .concept-stats {
      grid-template-columns: 1fr;
    }

    .concept-rows article {
      grid-template-columns: 38px minmax(0, 1fr);
    }

    .concept-rows > article > small {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
