---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
---

<Layout title="Character Profile | Might Forever">
  <PageHeader
    eyebrow="Roster · Character profile"
    title="Character Profile"
    description="Current Blizzard equipment with a guild-owned timeline that begins when this profile is first observed."
  />

  <p class="character-profile-back"><a href="/roster">Back to guild roster</a></p>

  <section class="panel character-profile-loading" data-character-loading aria-live="polite">
    <p class="eyebrow">Loading profile</p>
    <h2>Connecting to Blizzard…</h2>
    <div class="character-profile-loading-lines" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </section>

  <section class="panel roster-error-state" data-character-error hidden>
    <p class="eyebrow">Profile unavailable</p>
    <h2>We could not load this character</h2>
    <p data-character-error-message>The character profile is temporarily unavailable.</p>
    <a class="filter-button" href="/roster">Return to roster</a>
  </section>

  <div class="character-profile" data-character-content hidden>
    <section class="panel character-profile-hero" data-character-hero>
      <div class="character-profile-identity">
        <img class="character-profile-avatar" data-character-avatar alt="" hidden />
        <div>
          <p class="eyebrow" data-character-guild>Might</p>
          <h2 data-character-name>Character</h2>
          <p class="character-profile-subtitle" data-character-subtitle></p>
          <div class="character-profile-actions">
            <span class="character-profile-updated" data-character-updated></span>
            <a class="filter-button is-subtle" data-character-armory target="_blank" rel="noreferrer">
              Open Blizzard Armory
            </a>
          </div>
        </div>
      </div>
      <div class="character-profile-highlights" aria-label="Character summary">
        <div><span>Level</span><strong data-character-level>—</strong></div>
        <div><span>Equipped iLvl</span><strong data-character-equipped-ilvl>—</strong></div>
        <div><span>Average iLvl</span><strong data-character-average-ilvl>—</strong></div>
        <div><span>Honorable kills</span><strong data-character-honorable-kills>—</strong></div>
      </div>
    </section>

    <div class="character-profile-primary-grid">
      <section class="panel character-equipment-panel" aria-labelledby="equipment-heading">
        <div class="character-section-heading">
          <div>
            <p class="eyebrow">Armory</p>
            <h2 id="equipment-heading">Current equipment</h2>
          </div>
          <p class="muted" data-equipment-count></p>
        </div>
        <div class="character-equipment-layout" aria-label="Equipped item paper doll">
          <div class="character-equipment-column is-left" data-equipment-left aria-label="Left equipment slots"></div>
          <figure class="character-render-stage">
            <img data-character-render alt="" hidden />
            <figcaption data-character-render-caption></figcaption>
          </figure>
          <div class="character-equipment-column" data-equipment-right aria-label="Right equipment slots"></div>
          <div class="character-equipment-weapons" data-equipment-weapons aria-label="Weapon equipment slots"></div>
        </div>
      </section>
    </div>

    <div class="character-profile-secondary-grid">
      <aside class="panel character-history-panel" aria-labelledby="history-heading">
        <div class="character-section-heading">
          <div>
            <p class="eyebrow">Character history</p>
            <h2 id="history-heading">Progress timeline</h2>
          </div>
          <span class="character-history-count" data-history-count></span>
        </div>
        <p class="character-history-note" data-history-note></p>
        <div class="character-item-level-history" data-item-level-history hidden></div>
        <ol class="character-history-list" data-history-list></ol>
      </aside>

      <section class="panel character-detail-panel" aria-labelledby="pvp-heading">
        <div class="character-section-heading">
          <div>
            <p class="eyebrow">PvP</p>
            <h2 id="pvp-heading">Battleground record</h2>
          </div>
        </div>
        <div class="character-pvp-summary" data-pvp-summary></div>
      </section>

      <section class="panel character-detail-panel" aria-labelledby="stats-heading">
        <div class="character-section-heading">
          <div>
            <p class="eyebrow">Character</p>
            <h2 id="stats-heading">Core statistics</h2>
          </div>
        </div>
        <dl class="character-stat-grid" data-character-statistics></dl>
        <section class="character-set-summary" data-character-sets hidden aria-labelledby="equipment-sets-heading">
          <div class="character-set-summary-heading">
            <div>
              <p class="eyebrow">Equipment sets</p>
              <h3 id="equipment-sets-heading">Set bonuses</h3>
            </div>
          </div>
          <div class="character-set-list" data-character-set-list></div>
        </section>
      </section>

      <section class="panel character-detail-panel" data-character-talents hidden aria-labelledby="talents-heading">
        <div class="character-section-heading">
          <div>
            <p class="eyebrow">Build</p>
            <h2 id="talents-heading">Talents</h2>
          </div>
          <span class="character-history-count" data-talent-summary></span>
        </div>
        <div class="character-talent-list" data-talent-list></div>
      </section>

      <section class="panel character-detail-panel" data-character-professions hidden aria-labelledby="professions-heading">
        <div class="character-section-heading">
          <div>
            <p class="eyebrow">Skills</p>
            <h2 id="professions-heading">Professions</h2>
          </div>
          <a class="overview-text-link" href="/crafting">Guild directory</a>
        </div>
        <div class="character-profession-list" data-profession-list></div>
      </section>

      <section class="panel character-detail-panel" aria-labelledby="reputation-heading">
        <div class="character-section-heading">
          <div>
            <p class="eyebrow">Reputation</p>
            <h2 id="reputation-heading">Highest standings</h2>
          </div>
        </div>
        <div class="character-reputation-list" data-character-reputations></div>
      </section>
    </div>
  </div>
</Layout>

<script>
  type EquipmentItem = {
    id: number;
    slot: string;
    slotLabel: string;
    inventoryType?: string | null;
    name: string;
    itemLevel: number | null;
    quality: string;
    qualityLabel: string;
    iconUrl: string | null;
    enchantments: string[];
    setName: string | null;
  };

  type CharacterPayload = {
    ok: true;
    syncedAt: string;
    character: {
      id: number;
      slug: string;
      name: string;
      level: number;
      className: string;
      raceName: string;
      faction: string;
      guildName: string;
      specialization: string;
      role: string;
      achievementPoints: number;
      equippedItemLevel: number | null;
      averageItemLevel: number | null;
      lastLoginAt: string | null;
      armoryUrl: string;
    };
    media: { avatarUrl: string | null; renderUrl: string | null };
    equipment: EquipmentItem[];
    equipmentSets?: Array<{
      id: number | null;
      name: string;
      equippedCount: number;
      totalCount: number;
      equippedItems: string[];
      bonuses: Array<{
        requiredCount: number;
        description: string;
        active: boolean;
      }>;
    }>;
    talentTrees?: Array<{
      id: number | null;
      name: string;
      spentPoints: number;
      talents: Array<{ id: number | null; name: string; rank: number }>;
    }>;
    professions?: Array<{
      id: number | null;
      name: string;
      category: "Primary" | "Secondary";
      skill: number;
      maxSkill: number;
    }>;
    achievements?: Array<{
      id: number | null;
      name: string;
      completedAt: string;
    }>;
    pvp: {
      honorableKills: number;
      rank: number;
      maps: Array<{ name: string; played: number; won: number; lost: number }>;
    };
    statistics: Array<{ key: string; label: string; value: number; format?: "number" | "percent" }>;
    reputations: Array<{
      id: number;
      name: string;
      standing: string;
      value: number;
      max: number;
      tier: number;
    }>;
    history: {
      available: boolean;
      baselineAt: string | null;
      latestSnapshotAt: string | null;
      snapshotCount: number;
      snapshots?: Array<{
        capturedAt: string;
        equippedItemLevel: number | null;
        averageItemLevel: number | null;
        honorableKills: number;
      }>;
      events: Array<{
        id: number;
        type: "GAINED";
        itemId: number;
        itemName: string;
        itemLevel: number | null;
        quality: string;
        slot: string;
        occurredAt: string;
      }>;
    };
  };

  const classColors: Record<string, string> = {
    Druid: "#ff7c0a",
    Hunter: "#aad372",
    Mage: "#3fc7eb",
    Paladin: "#f48cba",
    Priest: "#ffffff",
    Rogue: "#fff468",
    Shaman: "#0070dd",
    Warlock: "#8788ee",
    Warrior: "#c69b6d",
  };
  const qualityColors: Record<string, string> = {
    POOR: "#9d9d9d",
    COMMON: "#ffffff",
    UNCOMMON: "#1eff00",
    RARE: "#0070dd",
    EPIC: "#a335ee",
    LEGENDARY: "#ff8000",
  };
  const getQualityColor = (quality: string) => qualityColors[quality.trim().toLocaleUpperCase()] ?? "#f2f0e8";
  const leftSlots = [
    { key: "HEAD", label: "Head" },
    { key: "NECK", label: "Neck" },
    { key: "SHOULDERS", label: "Shoulders" },
    { key: "BACK", label: "Back" },
    { key: "CHEST", label: "Chest" },
    { key: "SHIRT", label: "Shirt" },
    { key: "TABARD", label: "Tabard" },
    { key: "WRIST", label: "Wrist" },
  ] as const;
  const rightSlots = [
    { key: "HANDS", label: "Hands" },
    { key: "WAIST", label: "Waist" },
    { key: "LEGS", label: "Legs" },
    { key: "FEET", label: "Feet" },
    { key: "RING_1", label: "Ring 1" },
    { key: "RING_2", label: "Ring 2" },
    { key: "TRINKET_1", label: "Trinket 1" },
    { key: "TRINKET_2", label: "Trinket 2" },
  ] as const;
  const weaponSlots = [
    { key: "MAIN_HAND", label: "Main Hand" },
    { key: "OFF_HAND", label: "Off Hand" },
    { key: "RANGED", label: "Ranged" },
    { key: "AMMO", label: "Ammo" },
  ] as const;
  const loading = document.querySelector<HTMLElement>("[data-character-loading]");
  const errorState = document.querySelector<HTMLElement>("[data-character-error]");
  const errorMessage = document.querySelector<HTMLElement>("[data-character-error-message]");
  const content = document.querySelector<HTMLElement>("[data-character-content]");
  const leftEquipment = document.querySelector<HTMLElement>("[data-equipment-left]");
  const rightEquipment = document.querySelector<HTMLElement>("[data-equipment-right]");
  const weaponEquipment = document.querySelector<HTMLElement>("[data-equipment-weapons]");
  const historyList = document.querySelector<HTMLOListElement>("[data-history-list]");

  const setText = (selector: string, value: string | number) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = String(value);
  };

  const formatDate = (value: string | null, includeTime = true) => {
    if (!value) return "Not available";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "Not available";
    return new Intl.DateTimeFormat("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
      ...(includeTime ? { hour: "numeric", minute: "2-digit" } : {}),
      timeZone: "America/Los_Angeles",
      timeZoneName: includeTime ? "short" : undefined,
    }).format(date);
  };

  const getSlotKey = (value: string) => value.trim().toLocaleUpperCase().replaceAll(/[^A-Z0-9]+/g, "_");

  const enchantableSlots = new Set([
    "HEAD",
    "SHOULDERS",
    "BACK",
    "CHEST",
    "WRIST",
    "HANDS",
    "LEGS",
    "FEET",
    "MAIN_HAND",
  ]);
  const enchantableOffHandTypes = new Set(["SHIELD", "WEAPON", "WEAPONOFFHAND"]);

  const isMissingEnchant = (item: EquipmentItem, characterLevel: number) => {
    if (characterLevel < 60 || item.enchantments.length > 0) return false;
    const slotKey = getSlotKey(item.slot);
    return (
      enchantableSlots.has(slotKey) ||
      (slotKey === "OFF_HAND" && enchantableOffHandTypes.has(item.inventoryType ?? ""))
    );
  };

  const createEquipmentItem = (item: EquipmentItem | undefined, slotLabel: string, characterLevel: number) => {
    const row = document.createElement("article");
    const artwork = document.createElement("div");
    const copy = document.createElement("div");
    const name = document.createElement("strong");
    const slot = document.createElement("span");
    const detail = document.createElement("small");
    row.className = "character-equipment-item";
    artwork.className = "character-item-artwork";
    copy.className = "character-item-copy";
    slot.className = "character-item-slot";
    slot.textContent = slotLabel;

    if (!item) {
      row.classList.add("is-empty");
      name.textContent = "Empty slot";
      artwork.setAttribute("aria-hidden", "true");
      artwork.textContent = "—";
      copy.append(slot, name);
      row.append(artwork, copy);
      return row;
    }

    const missingEnchant = isMissingEnchant(item, characterLevel);
    const qualityColor = getQualityColor(item.quality);
    row.style.setProperty("--item-quality", qualityColor);
    row.title = [
      item.name,
      item.qualityLabel,
      item.itemLevel === null ? "" : `Item level ${item.itemLevel}`,
      ...item.enchantments,
      item.setName ?? "",
      missingEnchant ? "Missing enchant" : "",
    ]
      .filter(Boolean)
      .join(" · ");
    name.textContent = item.name;
    detail.textContent = [
      item.itemLevel === null ? "" : `Item level ${item.itemLevel}`,
      item.enchantments[0] ?? "",
      item.setName ?? "",
    ]
      .filter(Boolean)
      .join(" · ");

    if (item.iconUrl) {
      const image = document.createElement("img");
      image.src = item.iconUrl;
      image.alt = "";
      image.loading = "lazy";
      artwork.append(image);
    } else {
      artwork.textContent = item.slotLabel.slice(0, 1);
    }

    if (item.itemLevel !== null) {
      const itemLevel = document.createElement("span");
      itemLevel.className = "character-item-level";
      itemLevel.textContent = String(item.itemLevel);
      artwork.append(itemLevel);
    }

    copy.append(slot, name, detail);

    if (missingEnchant) {
      const warning = document.createElement("span");
      const warningIcon = document.createElement("span");
      warning.className = "character-item-warning";
      warning.setAttribute("aria-label", `${item.name} is missing an enchant`);
      warning.title = "No enchantment reported by Blizzard";
      warningIcon.className = "character-item-warning-icon";
      warningIcon.setAttribute("aria-hidden", "true");
      warningIcon.textContent = "!";
      warning.append(warningIcon, "Missing enchant");
      copy.append(warning);
    }

    row.append(artwork, copy);
    return row;
  };

  const renderEquipment = (items: EquipmentItem[], characterLevel: number) => {
    if (!leftEquipment || !rightEquipment || !weaponEquipment) return;
    leftEquipment.replaceChildren();
    rightEquipment.replaceChildren();
    weaponEquipment.replaceChildren();
    const itemsBySlot = new Map(items.map((item) => [getSlotKey(item.slot), item]));

    for (const slot of leftSlots) {
      leftEquipment.append(createEquipmentItem(itemsBySlot.get(slot.key), slot.label, characterLevel));
    }
    for (const slot of rightSlots) {
      rightEquipment.append(createEquipmentItem(itemsBySlot.get(slot.key), slot.label, characterLevel));
    }
    for (const slot of weaponSlots) {
      weaponEquipment.append(createEquipmentItem(itemsBySlot.get(slot.key), slot.label, characterLevel));
    }

    setText("[data-equipment-count]", `${items.length} equipped items`);
  };

  const renderHistory = (payload: CharacterPayload) => {
    if (!historyList) return;
    historyList.replaceChildren();
    const achievements = payload.achievements ?? [];
    const snapshots = (payload.history.snapshots ?? []).filter((snapshot) => snapshot.equippedItemLevel !== null);
    const timeline = [
      ...payload.history.events.map((event) => ({
        kind: "gear" as const,
        occurredAt: event.occurredAt,
        title: `Gained ${event.itemName}`,
        detail: [event.itemLevel === null ? "" : `Item level ${event.itemLevel}`, event.slot.replaceAll("_", " ").toLocaleLowerCase()]
          .filter(Boolean)
          .join(" · "),
        quality: event.quality,
      })),
      ...achievements.map((achievement) => ({
        kind: "achievement" as const,
        occurredAt: achievement.completedAt,
        title: achievement.name,
        detail: "Achievement completed",
        quality: "",
      })),
    ]
      .sort((left, right) => right.occurredAt.localeCompare(left.occurredAt))
      .slice(0, 24);
    setText(
      "[data-history-count]",
      `${timeline.length} event${timeline.length === 1 ? "" : "s"} · ${payload.history.snapshotCount} snapshot${payload.history.snapshotCount === 1 ? "" : "s"}`,
    );

    if (!payload.history.available) {
      setText("[data-history-note]", "History storage is being connected. Current equipment is still live.");
      return;
    }

    setText(
      "[data-history-note]",
      timeline.length
        ? "A combined history of first-seen gear and recent Blizzard achievements. Re-equips do not create duplicate gains."
        : "Tracking has started. Future first-seen gear and achievements will appear here.",
    );

    const chart = document.querySelector<HTMLElement>("[data-item-level-history]");
    if (chart) {
      chart.replaceChildren();
      chart.hidden = snapshots.length === 0;

      if (snapshots.length > 0) {
        const heading = document.createElement("div");
        const label = document.createElement("span");
        const value = document.createElement("strong");
        const levels = snapshots.map((snapshot) => snapshot.equippedItemLevel as number);
        label.textContent = "Equipped item level";
        value.textContent = snapshots.length > 1 ? `${levels[0]} → ${levels.at(-1)}` : `Baseline ${levels[0]}`;
        heading.className = "character-item-level-history-heading";
        heading.append(label, value);
        chart.append(heading);

        if (snapshots.length > 1) {
          const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
          const line = document.createElementNS("http://www.w3.org/2000/svg", "polyline");
          const min = Math.min(...levels);
          const max = Math.max(...levels);
          const range = Math.max(1, max - min);
          const points = levels
            .map((level, index) => {
              const x = 4 + (index / Math.max(1, levels.length - 1)) * 92;
              const y = 30 - ((level - min) / range) * 24;
              return `${x},${y}`;
            })
            .join(" ");
          svg.setAttribute("viewBox", "0 0 100 36");
          svg.setAttribute("role", "img");
          svg.setAttribute("aria-label", `Equipped item level changed from ${levels[0]} to ${levels.at(-1)}`);
          line.setAttribute("points", points);
          svg.append(line);
          chart.append(svg);
        }
      }
    }

    for (const event of timeline) {
      const item = document.createElement("li");
      const marker = document.createElement("span");
      const copy = document.createElement("div");
      const heading = document.createElement("strong");
      const detail = document.createElement("small");
      marker.className = `character-history-marker is-${event.kind}`;
      heading.textContent = event.title;
      if (event.quality) heading.style.setProperty("--item-quality", getQualityColor(event.quality));
      detail.textContent = [event.detail, formatDate(event.occurredAt)].filter(Boolean).join(" · ");
      copy.append(heading, detail);
      item.append(marker, copy);
      historyList.append(item);
    }

    if (payload.history.baselineAt) {
      const baseline = document.createElement("li");
      const marker = document.createElement("span");
      const copy = document.createElement("div");
      const heading = document.createElement("strong");
      const detail = document.createElement("small");
      marker.className = "character-history-marker is-baseline";
      heading.textContent = "Gear tracking baseline recorded";
      detail.textContent = `${formatDate(payload.history.baselineAt)} · existing items were not marked as newly gained`;
      copy.append(heading, detail);
      baseline.append(marker, copy);
      historyList.append(baseline);
    }
  };

  const renderPvp = (payload: CharacterPayload) => {
    const container = document.querySelector<HTMLElement>("[data-pvp-summary]");
    if (!container) return;
    container.replaceChildren();
    const totalWins = payload.pvp.maps.reduce((total, map) => total + map.won, 0);
    const totalLosses = payload.pvp.maps.reduce((total, map) => total + map.lost, 0);
    const metrics = [
      ["Honorable kills", payload.pvp.honorableKills],
      ["Battleground wins", totalWins],
      ["Battleground losses", totalLosses],
    ] as const;

    for (const [label, value] of metrics) {
      const metric = document.createElement("div");
      const term = document.createElement("span");
      const number = document.createElement("strong");
      term.textContent = label;
      number.textContent = String(value);
      metric.append(term, number);
      container.append(metric);
    }

    for (const map of payload.pvp.maps) {
      const row = document.createElement("p");
      row.textContent = `${map.name}: ${map.won}–${map.lost} across ${map.played} matches`;
      container.append(row);
    }
  };

  const renderStatistics = (payload: CharacterPayload) => {
    const list = document.querySelector<HTMLElement>("[data-character-statistics]");
    if (!list) return;
    list.replaceChildren();
    const statsByKey = new Map(payload.statistics.map((statistic) => [statistic.key, statistic]));
    const isTank = payload.character.role === "Tank";
    const isHealer = payload.character.role === "Healer";
    const isHunter = payload.character.className === "Hunter";
    const isCaster = ["Mage", "Priest", "Warlock"].includes(payload.character.className) || payload.character.role === "Ranged DPS";
    const preferredKeys = isTank
      ? ["health", "stamina", "strength", "armor", "dodge", "parry", "block", "defense", "attack_power", "melee_crit", "melee_hit"]
      : isHealer
        ? ["health", "power", "intellect", "stamina", "spirit", "spell_power", "bonus_healing", "mana_regen", "spell_crit", "spell_hit"]
        : isHunter
          ? ["health", "agility", "stamina", "attack_power", "main_hand_dps", "ranged_crit", "ranged_hit", "armor"]
          : isCaster
            ? ["health", "power", "intellect", "stamina", "spirit", "spell_power", "spell_crit", "spell_hit", "mana_regen"]
            : ["health", "strength", "agility", "stamina", "attack_power", "main_hand_dps", "melee_crit", "melee_hit", "armor"];
    const selected = [
      ...preferredKeys.flatMap((key) => (statsByKey.has(key) ? [statsByKey.get(key)!] : [])),
      ...payload.statistics.filter((statistic) => !preferredKeys.includes(statistic.key)),
    ]
      .filter((statistic, index, values) => values.findIndex((value) => value.key === statistic.key) === index)
      .slice(0, 10);

    for (const statistic of selected) {
      const wrapper = document.createElement("div");
      const term = document.createElement("dt");
      const description = document.createElement("dd");
      term.textContent = statistic.label;
      const formatted = new Intl.NumberFormat("en-US", { maximumFractionDigits: 1 }).format(statistic.value);
      description.textContent = statistic.format === "percent" ? `${formatted}%` : formatted;
      wrapper.append(term, description);
      list.append(wrapper);
    }
  };

  const renderEquipmentSets = (payload: CharacterPayload) => {
    const section = document.querySelector<HTMLElement>("[data-character-sets]");
    const list = document.querySelector<HTMLElement>("[data-character-set-list]");

    if (!section || !list) return;
    list.replaceChildren();
    const equipmentSets = (payload.equipmentSets ?? [])
      .map((equipmentSet) => ({
        ...equipmentSet,
        bonuses: equipmentSet.bonuses.filter((bonus) => bonus.active),
      }))
      .filter((equipmentSet) => equipmentSet.bonuses.length > 0);

    if (!equipmentSets.length) {
      section.hidden = true;
      return;
    }

    for (const equipmentSet of equipmentSets) {
      const card = document.createElement("article");
      const heading = document.createElement("div");
      const name = document.createElement("strong");
      const bonuses = document.createElement("ul");
      card.className = "character-set-card";
      heading.className = "character-set-card-heading";
      name.textContent = equipmentSet.name;
      bonuses.className = "character-set-bonuses";

      for (const bonus of equipmentSet.bonuses) {
        const row = document.createElement("li");
        const threshold = document.createElement("span");
        const description = document.createElement("span");
        row.className = "is-active";
        row.setAttribute("aria-label", `${bonus.requiredCount}-piece bonus: ${bonus.description}`);
        threshold.className = "character-set-threshold";
        threshold.textContent = `${bonus.requiredCount}-piece`;
        description.textContent = bonus.description;
        row.append(threshold, description);
        bonuses.append(row);
      }

      heading.append(name);
      card.append(heading, bonuses);
      list.append(card);
    }

    section.hidden = false;
  };

  const renderTalents = (payload: CharacterPayload) => {
    const section = document.querySelector<HTMLElement>("[data-character-talents]");
    const list = document.querySelector<HTMLElement>("[data-talent-list]");
    const trees = payload.talentTrees ?? [];

    if (!section || !list) return;
    list.replaceChildren();

    if (!trees.length) {
      section.hidden = true;
      return;
    }

    setText("[data-talent-summary]", trees.map((tree) => tree.spentPoints).join(" / "));
    for (const tree of trees) {
      const card = document.createElement("article");
      const heading = document.createElement("div");
      const name = document.createElement("strong");
      const points = document.createElement("span");
      const talents = document.createElement("div");
      card.className = "character-talent-card";
      heading.className = "character-talent-heading";
      name.textContent = tree.name;
      points.textContent = `${tree.spentPoints} points`;
      talents.className = "character-talent-chips";
      for (const talent of tree.talents.slice(0, 12)) {
        const chip = document.createElement("span");
        chip.textContent = `${talent.name}${talent.rank > 1 ? ` ${talent.rank}` : ""}`;
        talents.append(chip);
      }
      heading.append(name, points);
      card.append(heading);
      if (tree.talents.length) card.append(talents);
      list.append(card);
    }
    section.hidden = false;
  };

  const renderProfessions = (payload: CharacterPayload) => {
    const section = document.querySelector<HTMLElement>("[data-character-professions]");
    const list = document.querySelector<HTMLElement>("[data-profession-list]");
    const professions = payload.professions ?? [];

    if (!section || !list) return;
    list.replaceChildren();

    if (!professions.length) {
      section.hidden = true;
      return;
    }

    for (const profession of professions) {
      const row = document.createElement("div");
      const heading = document.createElement("div");
      const name = document.createElement("span");
      const value = document.createElement("strong");
      const track = document.createElement("div");
      const bar = document.createElement("div");
      row.className = "character-profession-row";
      heading.className = "character-profession-heading";
      name.textContent = `${profession.name}${profession.category === "Secondary" ? " · Secondary" : ""}`;
      value.textContent = profession.maxSkill > 0 ? `${profession.skill} / ${profession.maxSkill}` : String(profession.skill);
      track.className = "character-profession-track";
      bar.className = "character-profession-bar";
      bar.style.width = `${profession.maxSkill > 0 ? Math.min(100, (profession.skill / profession.maxSkill) * 100) : 0}%`;
      track.setAttribute("role", "progressbar");
      track.setAttribute("aria-label", `${profession.name}: ${value.textContent}`);
      track.setAttribute("aria-valuemin", "0");
      track.setAttribute("aria-valuemax", String(profession.maxSkill));
      track.setAttribute("aria-valuenow", String(profession.skill));
      heading.append(name, value);
      track.append(bar);
      row.append(heading, track);
      list.append(row);
    }
    section.hidden = false;
  };

  const renderReputations = (payload: CharacterPayload) => {
    const list = document.querySelector<HTMLElement>("[data-character-reputations]");
    if (!list) return;
    list.replaceChildren();

    for (const reputation of payload.reputations.slice(0, 8)) {
      const row = document.createElement("div");
      const heading = document.createElement("div");
      const name = document.createElement("span");
      const standing = document.createElement("span");
      const track = document.createElement("div");
      const bar = document.createElement("div");
      row.className = "character-reputation-row";
      heading.className = "character-reputation-heading";
      name.textContent = reputation.name;
      standing.textContent = reputation.standing;
      track.className = "character-reputation-track";
      bar.className = "character-reputation-bar";
      bar.style.width = `${reputation.max > 0 ? Math.min(100, (reputation.value / reputation.max) * 100) : 100}%`;
      track.setAttribute("role", "progressbar");
      track.setAttribute("aria-label", `${reputation.name}: ${reputation.standing}`);
      track.setAttribute("aria-valuemin", "0");
      track.setAttribute("aria-valuemax", String(reputation.max));
      track.setAttribute("aria-valuenow", String(reputation.value));
      heading.append(name, standing);
      track.append(bar);
      row.append(heading, track);
      list.append(row);
    }
  };

  const renderCharacter = (payload: CharacterPayload) => {
    document.title = `${payload.character.name} | Might Forever`;
    setText("[data-character-guild]", payload.character.guildName);
    setText("[data-character-name]", payload.character.name);
    setText(
      "[data-character-subtitle]",
      `${payload.character.raceName} ${payload.character.className} · ${payload.character.specialization} · ${payload.character.role}`,
    );
    setText("[data-character-level]", payload.character.level);
    setText("[data-character-equipped-ilvl]", payload.character.equippedItemLevel ?? "—");
    setText("[data-character-average-ilvl]", payload.character.averageItemLevel ?? "—");
    setText("[data-character-honorable-kills]", payload.pvp.honorableKills);
    setText("[data-character-updated]", `Updated ${formatDate(payload.syncedAt)}`);
    setText("[data-character-render-caption]", `${payload.character.specialization} ${payload.character.className}`);

    const hero = document.querySelector<HTMLElement>("[data-character-hero]");
    hero?.style.setProperty("--character-color", classColors[payload.character.className] ?? "#7c8cff");
    const armoryLink = document.querySelector<HTMLAnchorElement>("[data-character-armory]");
    if (armoryLink) armoryLink.href = payload.character.armoryUrl;
    const avatar = document.querySelector<HTMLImageElement>("[data-character-avatar]");
    if (avatar && payload.media.avatarUrl) {
      avatar.src = payload.media.avatarUrl;
      avatar.alt = `${payload.character.name} portrait`;
      avatar.hidden = false;
    }
    const render = document.querySelector<HTMLImageElement>("[data-character-render]");
    if (render && payload.media.renderUrl) {
      render.src = payload.media.renderUrl;
      render.alt = `${payload.character.name} character render`;
      render.hidden = false;
    }

    renderEquipment(payload.equipment, payload.character.level);
    renderHistory(payload);
    renderPvp(payload);
    renderStatistics(payload);
    renderEquipmentSets(payload);
    renderTalents(payload);
    renderProfessions(payload);
    renderReputations(payload);
    if (loading) loading.hidden = true;
    if (content) content.hidden = false;
  };

  const showError = (message: string) => {
    if (loading) loading.hidden = true;
    if (errorState) errorState.hidden = false;
    if (errorMessage) errorMessage.textContent = message;
  };

  const loadCharacter = async () => {
    const match = window.location.pathname.match(/^\/roster\/profile\/([^/]+)\/?$/);
    const slug = match?.[1] ? decodeURIComponent(match[1]).toLocaleLowerCase() : "";

    if (!slug || slug === "index.html") {
      showError("Choose a character from the guild roster.");
      return;
    }

    try {
      const response = await fetch(`/api/forever-character/${encodeURIComponent(slug)}?v=4`, {
        headers: { Accept: "application/json" },
      });
      const payload = (await response.json()) as CharacterPayload | { ok?: false; message?: string };

      if (!response.ok || payload.ok !== true || !("character" in payload)) {
        throw new Error("message" in payload && payload.message ? payload.message : "Unable to load this character.");
      }

      renderCharacter(payload);
    } catch (error) {
      showError(error instanceof Error ? error.message : "Unable to load this character.");
    }
  };

  void loadCharacter();
</script>
