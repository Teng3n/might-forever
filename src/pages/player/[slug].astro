---
import Layout from "../../layouts/Layout.astro";
import StatCard from "../../components/StatCard.astro";
import {
  lootBucketColors,
  lootBucketLabels,
  type LootBucketKey,
  type LootTimelinePoint,
} from "../../lib/lootTiers";
import { getPlayerNameStyle } from "../../lib/playerStyles";
import { getPlayerProfiles, type PlayerProfile } from "../../lib/playerProfiles";

export const getStaticPaths = () =>
  getPlayerProfiles().map((profile) => ({
    params: { slug: profile.slug },
    props: { profile },
  }));

const { profile } = Astro.props as { profile: PlayerProfile };
const classSpec = [profile.className, profile.spec].filter(Boolean).join(" / ") || "Class and spec not listed";
const lootBucketKeys: LootBucketKey[] = ["bis", "major", "minor", "offspec", "bonusRolls"];
const defaultVisibleLootBuckets = new Set<LootBucketKey>(["bis", "major", "minor"]);
const lootHistoryPageSize = 25;
const selectedLootTierSlug = profile.lootByTier[0]?.tierSlug;
const chartWidth = 940;
const chartHeight = 280;
const chartPadding = { top: 20, right: 26, bottom: 42, left: 42 };
const chartInnerWidth = chartWidth - chartPadding.left - chartPadding.right;
const chartInnerHeight = chartHeight - chartPadding.top - chartPadding.bottom;
const getTimelineMax = (timeline: LootTimelinePoint[]) =>
  Math.max(1, ...timeline.flatMap((point) => lootBucketKeys.map((key) => point[key])));
const getTimelineBar = (timeline: LootTimelinePoint[], key: LootBucketKey, index: number) => {
  const point = timeline[index];
  const maxValue = getTimelineMax(timeline);
  const groupWidth = chartInnerWidth / Math.max(timeline.length, 1);
  const clusterWidth = Math.min(groupWidth * 0.44, 132);
  const barWidth = Math.max(4, Math.min(52, clusterWidth / 3));
  const barStep = lootBucketKeys.length > 1 ? (clusterWidth - barWidth) / (lootBucketKeys.length - 1) : 0;
  const keyIndex = lootBucketKeys.indexOf(key);
  const height = (point[key] / maxValue) * chartInnerHeight;
  const groupCenter = chartPadding.left + index * groupWidth + groupWidth / 2;
  const clusterLeft = groupCenter - clusterWidth / 2;
  const x = clusterLeft + keyIndex * barStep;
  const y = chartPadding.top + chartInnerHeight - height;

  return { x, y, width: barWidth, height, value: point[key], centerX: x + barWidth / 2 };
};
const getTimelineTicks = (timeline: LootTimelinePoint[]) => {
  if (timeline.length <= 6) {
    return timeline.map((point, index) => ({ ...point, index }));
  }

  const lastIndex = timeline.length - 1;
  const step = Math.ceil(timeline.length / 6);
  return timeline
    .map((point, index) => ({ ...point, index }))
    .filter((point) => point.index === 0 || point.index === lastIndex || point.index % step === 0);
};
const getTickX = (index: number, timelineLength: number) =>
  chartPadding.left + ((index + 0.5) / Math.max(timelineLength, 1)) * chartInnerWidth;
---

<Layout title={`${profile.character} | Might Forever`}>
  <section class="page-header">
    <p class="eyebrow">Player Profile</p>
    <h1 class="player-name" style={getPlayerNameStyle(profile.character)}>{profile.character}</h1>
  </section>

  <section class="panel profile-overview">
    <div>
      <p class="eyebrow">Character</p>
      <div class="profile-character-heading">
        <h2 class="profile-character player-name" style={getPlayerNameStyle(profile.character)}>{profile.character}</h2>
        <a
          class="warcraft-logs-link"
          href={profile.warcraftLogsDirectUrl ?? profile.warcraftLogsUrl}
          target="_blank"
          rel="noreferrer"
          aria-label={`View ${profile.character} on Warcraft Logs`}
          title="View on Warcraft Logs"
        >
          <img src="/warcraft-logs-icon.svg" alt="" width="34" height="34" loading="lazy" />
        </a>
      </div>
      <p class="muted">{profile.rosterStatus}</p>
    </div>
    <dl class="profile-meta">
      <div>
        <dt>Class / Spec</dt>
        <dd>{classSpec}</dd>
      </div>
      <div>
        <dt>Role</dt>
        <dd>{profile.role ?? "Not listed"}</dd>
      </div>
    </dl>
  </section>

  <section class="profile-attendance-grid" aria-label="Attendance summary">
    <StatCard label="Out" value={profile.attendance.out} detail="Out marks" />
    <StatCard label="Late" value={profile.attendance.late} detail="Late marks" />
    <StatCard label="MIA" value={profile.attendance.mia} detail="MIA marks" />
  </section>

  <div class="profile-tier-content" data-profile-tier-tabs>
    <section class="panel profile-loot-panel">
      <div class="section-heading inline">
        <div>
          <p class="eyebrow">Tier Summary</p>
        </div>
        <div class="tier-tab-buttons" role="tablist" aria-label="Player loot tiers">
          {
            profile.lootByTier.map((tier) => (
              <button
                type="button"
                class="tier-tab-button"
                role="tab"
                aria-selected={tier.tierSlug === selectedLootTierSlug ? "true" : "false"}
                data-tier-tab={tier.tierSlug}
              >
                {tier.shortLabel}
              </button>
            ))
          }
        </div>
      </div>

      {
        profile.lootByTier.map((tier) => (
          <div data-tier-panel={tier.tierSlug} hidden={tier.tierSlug !== selectedLootTierSlug}>
            <ul class="profile-loot-stat-list">
              {lootBucketKeys.map((key) => (
                <li style={`--loot-color: ${lootBucketColors[key]}`}>
                  <span>{lootBucketLabels[key]}</span>
                  <strong>{tier.lootSummary[key]}</strong>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="panel profile-loot-panel">
      <div class="section-heading">
        <p class="eyebrow">Loot Timeline</p>
      </div>

      {
        profile.lootByTier.map((tier) => {
          const timeline = tier.timeline;
          const timelineMax = getTimelineMax(timeline);

          return (
            <div data-tier-panel={tier.tierSlug} hidden={tier.tierSlug !== selectedLootTierSlug}>
              {timeline.length > 0 ? (
                <div
                  class="loot-timeline-chart"
                  aria-label={`${tier.tierLabel} weekly loot received timeline`}
                  data-loot-chart
                  data-chart-width={chartWidth}
                  data-chart-height={chartHeight}
                >
                  <svg viewBox={`0 0 ${chartWidth} ${chartHeight}`} role="img">
                    <line
                      x1={chartPadding.left}
                      y1={chartPadding.top + chartInnerHeight}
                      x2={chartPadding.left + chartInnerWidth}
                      y2={chartPadding.top + chartInnerHeight}
                      class="loot-chart-axis"
                    />
                    <line
                      x1={chartPadding.left}
                      y1={chartPadding.top}
                      x2={chartPadding.left}
                      y2={chartPadding.top + chartInnerHeight}
                      class="loot-chart-axis"
                    />
                    <text x={chartPadding.left - 10} y={chartPadding.top + 5} class="loot-chart-label" text-anchor="end">
                      {timelineMax}
                    </text>
                    <text x={chartPadding.left - 10} y={chartPadding.top + chartInnerHeight + 4} class="loot-chart-label" text-anchor="end">
                      0
                    </text>
                    {getTimelineTicks(timeline).map((tick) => (
                      <>
                        <line
                          x1={getTickX(tick.index, timeline.length)}
                          y1={chartPadding.top + chartInnerHeight}
                          x2={getTickX(tick.index, timeline.length)}
                          y2={chartPadding.top + chartInnerHeight + 6}
                          class="loot-chart-axis"
                        />
                        <text
                          x={getTickX(tick.index, timeline.length)}
                          y={chartPadding.top + chartInnerHeight + 24}
                          class="loot-chart-label"
                          text-anchor="middle"
                        >
                          {tick.label}
                        </text>
                      </>
                    ))}
                    {lootBucketKeys.map((key) =>
                      timeline.map((point, index) => {
                        const chartBar = getTimelineBar(timeline, key, index);
                        const tooltipText = `${point.label}: ${chartBar.value} ${lootBucketLabels[key]}`;

                        return (
                          <rect
                            class="loot-chart-bar"
                            aria-label={tooltipText}
                            x={chartBar.x}
                            y={chartBar.y}
                            width={chartBar.width}
                            height={chartBar.height}
                            rx="2"
                            fill={lootBucketColors[key]}
                            data-loot-point
                            data-loot-key={key}
                            data-loot-week={point.label}
                            data-loot-value={chartBar.value}
                            data-loot-bucket={lootBucketLabels[key]}
                            data-tooltip-x={chartBar.centerX}
                            data-tooltip-y={chartBar.y}
                            data-loot-empty={chartBar.value === 0 ? "true" : undefined}
                            data-loot-hidden={!defaultVisibleLootBuckets.has(key) ? "true" : undefined}
                            tabindex={defaultVisibleLootBuckets.has(key) && chartBar.value > 0 ? "0" : "-1"}
                          />
                        );
                      }),
                    )}
                  </svg>
                  <div class="loot-chart-tooltip" data-loot-chart-tooltip hidden></div>
                  <div class="loot-chart-legend">
                    {lootBucketKeys.map((key) => (
                      <button
                        type="button"
                        class="loot-chart-legend-toggle"
                        style={`--loot-color: ${lootBucketColors[key]}`}
                        data-loot-toggle={key}
                        aria-pressed={defaultVisibleLootBuckets.has(key) ? "true" : "false"}
                      >
                        <span>{lootBucketLabels[key]}</span>
                      </button>
                    ))}
                  </div>
                </div>
              ) : (
                <p class="info-note">No loot timeline for this tier yet.</p>
              )}
            </div>
          );
        })
      }
    </section>

    <section class="panel profile-loot-panel">
      <div class="section-heading">
        <p class="eyebrow">Loot History</p>
      </div>

      {
        profile.lootByTier.map((tier) => {
          return (
            <div data-tier-panel={tier.tierSlug} hidden={tier.tierSlug !== selectedLootTierSlug}>
            <span class="muted profile-loot-row-status" data-profile-loot-page-status>{tier.recentLoot.length} rows</span>

            <div class="table-shell profile-loot-table-shell">
              <table class="data-table profile-loot-history-table" data-profile-loot-table data-page-size={lootHistoryPageSize}>
                <thead>
                  <tr>
                    <th aria-sort="descending">
                      <button class="sort-button" type="button" data-profile-sort-key="date" data-sort-type="text">
                        <span>Date</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                      </button>
                    </th>
                    <th>
                      <button class="sort-button" type="button" data-profile-sort-key="item" data-sort-type="text">
                        <span>Item</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                      </button>
                    </th>
                    <th>
                      <button class="sort-button" type="button" data-profile-sort-key="boss" data-sort-type="text">
                        <span>Boss</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                      </button>
                    </th>
                    <th>
                      <button class="sort-button" type="button" data-profile-sort-key="instance" data-sort-type="text">
                        <span>Instance</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                      </button>
                    </th>
                    <th>
                      <button class="sort-button" type="button" data-profile-sort-key="type" data-sort-type="text">
                        <span>Type</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                      </button>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {tier.recentLoot.length > 0 ? (
                    tier.recentLoot.map((row) => (
                      <tr
                        data-profile-loot-row
                        data-sort-date={row.date}
                        data-sort-item={row.item}
                        data-sort-boss={row.boss}
                        data-sort-instance={row.instance}
                        data-sort-type={row.type}
                      >
                        <td data-label="Date">{row.date}</td>
                        <td data-label="Item">{row.item}</td>
                        <td data-label="Boss">{row.boss}</td>
                        <td data-label="Instance">{row.instance}</td>
                        <td data-label="Type">{row.type}</td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td colspan={5}>No loot listed for this tier.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
            {tier.recentLoot.length > lootHistoryPageSize && (
              <div class="profile-loot-pagination">
                <button class="filter-button is-subtle" type="button" data-profile-page-prev>Previous</button>
                <span class="muted" data-profile-page-label></span>
                <button class="filter-button is-subtle" type="button" data-profile-page-next>Next</button>
              </div>
            )}
          </div>
        );
        })
      }
    </section>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-profile-tier-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tier-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-tier-panel]"));

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const targetTier = tab.dataset.tierTab;

        tabs.forEach((item) => {
          item.setAttribute("aria-selected", String(item === tab));
        });

        panels.forEach((panel) => {
          panel.hidden = panel.dataset.tierPanel !== targetTier;
        });
      });
    });
  });

  const compareText = (first: string, second: string) => first.localeCompare(second, undefined, { sensitivity: "base" });

  document.querySelectorAll<HTMLElement>("[data-loot-chart]").forEach((chart) => {
    const tooltip = chart.querySelector<HTMLElement>("[data-loot-chart-tooltip]");
    const chartWidth = Number(chart.dataset.chartWidth ?? 940);
    const chartHeight = Number(chart.dataset.chartHeight ?? 280);

    const showTooltip = (point: SVGElement) => {
      if (!tooltip || point.dataset.lootHidden === "true") {
        return;
      }

      const x = Number(point.dataset.tooltipX ?? 0);
      const y = Number(point.dataset.tooltipY ?? 0);
      tooltip.textContent = `${point.dataset.lootWeek}: ${point.dataset.lootValue} ${point.dataset.lootBucket}`;
      tooltip.style.left = `${(x / chartWidth) * 100}%`;
      tooltip.style.top = `${(y / chartHeight) * 100}%`;
      tooltip.dataset.placement = y < 58 ? "below" : "above";
      tooltip.hidden = false;
    };

    const hideTooltip = () => {
      if (tooltip) {
        tooltip.hidden = true;
      }
    };

    chart.querySelectorAll<SVGElement>("[data-loot-point]").forEach((point) => {
      point.addEventListener("pointerenter", () => showTooltip(point));
      point.addEventListener("pointerleave", hideTooltip);
      point.addEventListener("focus", () => showTooltip(point));
      point.addEventListener("blur", hideTooltip);
    });

    chart.querySelectorAll<HTMLButtonElement>("[data-loot-toggle]").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const key = toggle.dataset.lootToggle;
        const isActive = toggle.getAttribute("aria-pressed") === "true";
        const nextIsActive = !isActive;

        toggle.setAttribute("aria-pressed", String(nextIsActive));

        chart.querySelectorAll<SVGElement>(`[data-loot-key="${key}"]`).forEach((seriesItem) => {
          seriesItem.dataset.lootHidden = String(!nextIsActive);

          seriesItem.tabIndex = nextIsActive && seriesItem.dataset.lootEmpty !== "true" ? 0 : -1;
        });

        if (!nextIsActive) {
          hideTooltip();
        }
      });
    });
  });

  document.querySelectorAll<HTMLTableElement>("[data-profile-loot-table]").forEach((table) => {
    const container = table.closest<HTMLElement>("[data-tier-panel]");
    const tbody = table.tBodies[0];
    const headers = Array.from(table.tHead?.rows[0]?.cells ?? []);
    const pageSize = Number(table.dataset.pageSize ?? 25);
    const pageLabel = container?.querySelector<HTMLElement>("[data-profile-page-label]");
    const pageStatus = container?.querySelector<HTMLElement>("[data-profile-loot-page-status]");
    const previousButton = container?.querySelector<HTMLButtonElement>("[data-profile-page-prev]");
    const nextButton = container?.querySelector<HTMLButtonElement>("[data-profile-page-next]");
    let rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>("[data-profile-loot-row]"));
    let currentPage = 0;
    let sortKey = "date";
    let sortDirection: "ascending" | "descending" = "descending";

    const updatePagination = () => {
      const pageCount = Math.max(1, Math.ceil(rows.length / pageSize));
      currentPage = Math.min(currentPage, pageCount - 1);
      const start = currentPage * pageSize;
      const end = start + pageSize;

      rows.forEach((row, index) => {
        row.hidden = index < start || index >= end;
      });

      if (pageLabel) {
        pageLabel.textContent = rows.length > 0 ? `Page ${currentPage + 1} of ${pageCount}` : "";
      }

      if (pageStatus) {
        const firstVisible = rows.length === 0 ? 0 : start + 1;
        const lastVisible = Math.min(end, rows.length);
        pageStatus.textContent = rows.length > pageSize ? `${firstVisible}-${lastVisible} of ${rows.length} rows` : `${rows.length} rows`;
      }

      if (previousButton) {
        previousButton.disabled = currentPage === 0;
      }

      if (nextButton) {
        nextButton.disabled = currentPage >= pageCount - 1;
      }
    };

    const sortRows = () => {
      const multiplier = sortDirection === "ascending" ? 1 : -1;

      rows = rows.sort((first, second) => {
        const firstValue = first.dataset[`sort${sortKey.charAt(0).toUpperCase()}${sortKey.slice(1)}`] ?? "";
        const secondValue = second.dataset[`sort${sortKey.charAt(0).toUpperCase()}${sortKey.slice(1)}`] ?? "";
        const comparison = compareText(firstValue, secondValue);

        if (comparison !== 0) {
          return comparison * multiplier;
        }

        return compareText(first.dataset.sortDate ?? "", second.dataset.sortDate ?? "") * -1;
      });

      tbody.append(...rows);
      currentPage = 0;
      updatePagination();
    };

    headers.forEach((header) => {
      const button = header.querySelector<HTMLButtonElement>("[data-profile-sort-key]");

      button?.addEventListener("click", () => {
        const nextSortKey = button.dataset.profileSortKey ?? "date";
        sortDirection = sortKey === nextSortKey && sortDirection === "ascending" ? "descending" : "ascending";
        sortKey = nextSortKey;

        headers.forEach((item) => item.removeAttribute("aria-sort"));
        header.setAttribute("aria-sort", sortDirection);
        sortRows();
      });
    });

    previousButton?.addEventListener("click", () => {
      currentPage = Math.max(0, currentPage - 1);
      updatePagination();
    });

    nextButton?.addEventListener("click", () => {
      const pageCount = Math.max(1, Math.ceil(rows.length / pageSize));
      currentPage = Math.min(pageCount - 1, currentPage + 1);
      updatePagination();
    });

    updatePagination();
  });
</script>
