---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import StatCard from "../components/StatCard.astro";
---

<Layout title="Roster | Might Forever">
  <PageHeader eyebrow="Roster" title="Guild Roster" />

  <section class="dashboard-grid roster-summary-grid">
    <StatCard label="Roster Count" value={0} detail="Awaiting roster source" />
    <StatCard label="Tanks" value={0} />
    <StatCard label="Healers" value={0} />
    <StatCard label="Melee DPS" value={0} />
    <StatCard label="Ranged DPS" value={0} />
  </section>

  <section class="panel empty-state-panel">
    <p class="eyebrow">Foundation ready</p>
    <h2>No roster has been created yet</h2>
    <p class="info-note">
      This page is intentionally empty. When the Might Forever roster spreadsheet is ready, its
      data can be connected here without carrying over any Vitality MoP members.
    </p>
  </section>
</Layout>
