---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import surveyInsights from "../data/surveyInsights.json";

const discordUrl = "https://discord.gg/Eg3UkkgcGj";
---

<Layout title="Might Forever | Guild Development">
  <PageHeader eyebrow="Pre-launch" title="Might Forever" />

  <section class="content-grid two-column">
    <article class="panel copy-panel hero-panel">
      <div class="section-heading">
        <p class="eyebrow">A new chapter</p>
        <h2>Building the guild foundation</h2>
      </div>
      <div class="info-copy">
        <p>
          Might Forever is the working home for our next World of Warcraft guild. This site is a
          clean foundation for planning the launch, forming the roster, and building the systems
          the team will use once the game is closer.
        </p>
        <p>
          The old Mists of Pandaria data stays preserved in the Vitality MoP archive. Nothing from that
          roster, calendar, or loot history carries into this site.
        </p>
      </div>
    </article>

    <div class="stack homepage-side-stack">
      <article class="panel resources-panel">
        <div class="section-heading">
          <p class="eyebrow">Start here</p>
          <h2>Guild Links</h2>
        </div>
        <div class="resource-list compact">
          <a class="resource-link" href={discordUrl}>
            <span>Discord</span>
            <small>Community and planning</small>
          </a>
          <a class="resource-link" href="/roster">
            <span>Roster Foundation</span>
            <small>Ready for the future roster source</small>
          </a>
          <a class="resource-link" href="/officer/survey-insights">
            <span>Officer Survey Insights</span>
            <small>{surveyInsights.responseCount} launch survey responses</small>
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="dashboard-grid">
    <article class="stat-card">
      <span>Roster</span>
      <strong>0</strong>
      <small>Not yet formed</small>
    </article>
    <article class="stat-card">
      <span>Loot system</span>
      <strong>—</strong>
      <small>Not configured</small>
    </article>
    <article class="stat-card">
      <span>Survey responses</span>
      <strong>{surveyInsights.responseCount}</strong>
      <small>Officer analytics available</small>
    </article>
  </section>

  <section class="content-grid two-column">
    <article class="panel copy-panel">
      <div class="section-heading">
        <p class="eyebrow">Ready now</p>
        <h2>Planning infrastructure</h2>
      </div>
      <ul class="clean-list expectation-list">
        <li>Permanent Might Forever development deployment.</li>
        <li>Empty roster and data contracts ready for future spreadsheets.</li>
        <li>Officer-gated survey decision dashboard.</li>
        <li>Manual-only data refresh path with no background polling.</li>
      </ul>
    </article>

    <article class="panel copy-panel">
      <div class="section-heading">
        <p class="eyebrow">Later</p>
        <h2>Systems to connect</h2>
      </div>
      <ul class="clean-list expectation-list">
        <li>Roster and character data source.</li>
        <li>Raid calendar and availability.</li>
        <li>Loot policy and tracking, once the guild chooses a system.</li>
        <li>Progression and Warcraft Logs after the game launches.</li>
      </ul>
    </article>
  </section>
</Layout>
