---
import OfficerGate from "../../components/OfficerGate.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Raid Team Planner | Might Forever">
  <OfficerGate>
    <main class="raid-planner raid-planner-frames" data-raid-planner>
      <section class="page-header officer-client-heading raid-planner-header">
        <div>
          <p class="eyebrow">Officer · Raid Operations</p>
          <h1>Raid Team Planner</h1>
          <p>Build each raid the same way it appears in game: four groups, five slots per group, and one compact place to spot role and buff gaps.</p>
        </div>
        <div class="raid-planner-save-cluster">
          <span class="raid-planner-save-status" data-plan-status aria-live="polite">Loading saved plan…</span>
          <button class="filter-button is-subtle" type="button" data-reload-plan disabled>Reload</button>
          <button class="filter-button" type="button" data-save-plan disabled>Save plan</button>
        </div>
      </section>

      <section class="raid-planner-summary" aria-label="Raid planner summary">
        <article class="stat-card">
          <span>Level 60</span>
          <strong data-level-cap-count>—</strong>
          <small>Live Blizzard roster</small>
        </article>
        <article class="stat-card">
          <span>Assigned</span>
          <strong data-assigned-count>—</strong>
          <small>Across both teams</small>
        </article>
        <article class="stat-card">
          <span>Unassigned</span>
          <strong data-unassigned-count>—</strong>
          <small>Level 60 and available</small>
        </article>
        <article class="stat-card">
          <span>Split-ready tanks</span>
          <strong data-tank-ready-count>—</strong>
          <small>Tank or tank off-spec</small>
        </article>
      </section>

      <section class="panel raid-frame-guide">
        <span><strong>Groups 1–2</strong> become the first 10-player raid.</span>
        <span><strong>Groups 3–4</strong> become the second 10-player raid.</span>
        <span>Drag to a group, double-click for the next open slot, or select a name and then a slot.</span>
      </section>

      <section class="raid-planner-loading panel" data-planner-loading>
        Loading the guild roster and saved raid plan…
      </section>

      <section class="raid-frame-app" data-planner-workspace hidden>
        <section class="panel raid-frame-pool" data-player-pool-dropzone aria-labelledby="raid-pool-title">
          <div class="raid-frame-pool-toolbar">
            <div class="raid-frame-pool-heading">
              <h2 id="raid-pool-title">Available players</h2>
              <span data-visible-pool-count aria-live="polite"></span>
            </div>
            <label class="field raid-player-search">
              <span>Search by name</span>
              <input type="search" placeholder="Search levels 41 and up" data-player-search />
            </label>
            <label class="field">
              <span>Browse level 60 roles</span>
              <select data-player-role-filter>
                <option value="all">All roles</option>
                <option value="Tank">Tank</option>
                <option value="Healer">Healer</option>
                <option value="Melee DPS">Melee DPS</option>
                <option value="Ranged DPS">Ranged DPS</option>
              </select>
            </label>
          </div>
          <div class="raid-frame-pool-list" data-player-pool-list></div>
          <p class="raid-player-pool-empty" data-player-pool-empty hidden></p>
        </section>
        <nav class="raid-team-switcher" data-team-switcher aria-label="Raid team"></nav>
        <div class="raid-frame-main">
          <div class="panel raid-frame-board" data-raid-frame-board></div>
          <div class="raid-frame-lower-grid">
            <section class="panel raid-member-inspector" data-member-inspector></section>
            <section class="panel raid-frame-buffs" data-buff-panel></section>
          </div>
        </div>
      </section>
    </main>
  </OfficerGate>
</Layout>

<script>
  type RaidRole = "Tank" | "Healer" | "Melee DPS" | "Ranged DPS";
  type Subgroup = "A" | "B";
  type TeamId = "team-a" | "team-b";
  type CoverageView = "20" | "A" | "B";
  type RaidGroup = 1 | 2 | 3 | 4;

  type RosterMember = {
    slug: string;
    name: string;
    level: number;
    className: string;
    specialization: string;
    role: string;
    rankLabel: string;
    profileUrl: string;
  };

  type RaidAssignment = {
    characterSlug: string;
    assignedRole: RaidRole;
    assignedSpec: string;
    offspecTank: boolean;
    offspecHealer: boolean;
    subgroup: Subgroup;
    raidGroup: RaidGroup;
  };

  type RaidTeam = {
    id: TeamId;
    name: string;
    locked: boolean;
    assignments: RaidAssignment[];
  };

  type RaidPlan = { teams: RaidTeam[] };
  type PlannerResponse = { ok: true; plan: RaidPlan; version: number; updatedAt: string | null };
  type RosterResponse = { ok: true; members: RosterMember[] };

  const classColors: Record<string, string> = {
    Druid: "#ff7c0a", Hunter: "#aad372", Mage: "#3fc7eb", Paladin: "#f48cba", Priest: "#ffffff",
    Rogue: "#fff468", Shaman: "#0070dd", Warlock: "#8788ee", Warrior: "#c69b6d",
  };

  const classSpecs: Record<string, string[]> = {
    Druid: ["Balance", "Feral Combat", "Restoration"],
    Hunter: ["Beast Mastery", "Marksmanship", "Survival"],
    Mage: ["Arcane", "Fire", "Frost"],
    Paladin: ["Holy", "Protection", "Retribution"],
    Priest: ["Discipline", "Holy", "Shadow Magic"],
    Rogue: ["Assassination", "Combat", "Subtlety"],
    Shaman: ["Elemental Combat", "Enhancement", "Restoration"],
    Warlock: ["Affliction", "Demonology", "Destruction"],
    Warrior: ["Arms", "Fury", "Protection"],
  };

  const tankClasses = new Set(["Druid", "Paladin", "Warrior"]);
  const healerClasses = new Set(["Druid", "Paladin", "Priest", "Shaman"]);
  const levelCap = 60;
  const minimumSearchLevel = 41;
  const groupNumbers: RaidGroup[] = [1, 2, 3, 4];
  const roleAbbreviations: Record<RaidRole, string> = { Tank: "T", Healer: "H", "Melee DPS": "M", "Ranged DPS": "R" };
  const poolRoleIcons = {
    tank: "M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z",
    healer: "M12 5v14M5 12h14",
    dps: "M9 14 19 4h3v3L12 17M7 12l7 7m-4-4-5 5m-2-1 2 2",
    unknown: "M8.5 8a3.5 3.5 0 0 1 7 0c0 2.5-3.5 2.5-3.5 5m0 4h.01",
  };

  type CoveragePlayer = { member: RosterMember; assignment: RaidAssignment };
  type BuffRule = { name: string; source: string; kind: "core" | "specialist"; isCovered: (player: CoveragePlayer) => boolean };
  const hasSpec = (player: CoveragePlayer, term: string) =>
    player.assignment.assignedSpec.toLocaleLowerCase().includes(term.toLocaleLowerCase());
  const buffRules: BuffRule[] = [
    { name: "Mark of the Wild", source: "Druid", kind: "core", isCovered: ({ member }) => member.className === "Druid" },
    { name: "Fortitude", source: "Priest", kind: "core", isCovered: ({ member }) => member.className === "Priest" },
    { name: "Divine Spirit", source: "Priest", kind: "core", isCovered: ({ member }) => member.className === "Priest" },
    { name: "Arcane Intellect", source: "Mage", kind: "core", isCovered: ({ member }) => member.className === "Mage" },
    { name: "Paladin Blessings", source: "Paladin", kind: "core", isCovered: ({ member }) => member.className === "Paladin" },
    { name: "Battle Shout", source: "Warrior", kind: "core", isCovered: ({ member }) => member.className === "Warrior" },
    { name: "Shaman Totems", source: "Shaman", kind: "core", isCovered: ({ member }) => member.className === "Shaman" },
    { name: "Healthstones", source: "Warlock", kind: "core", isCovered: ({ member }) => member.className === "Warlock" },
    { name: "Tranquilizing Shot", source: "Hunter", kind: "core", isCovered: ({ member }) => member.className === "Hunter" },
    { name: "Leader of the Pack", source: "Feral Druid", kind: "specialist", isCovered: (player) => player.member.className === "Druid" && hasSpec(player, "Feral") },
    { name: "Moonkin Aura", source: "Balance Druid", kind: "specialist", isCovered: (player) => player.member.className === "Druid" && hasSpec(player, "Balance") },
    { name: "Trueshot Aura", source: "Marksmanship Hunter", kind: "specialist", isCovered: (player) => player.member.className === "Hunter" && hasSpec(player, "Marksmanship") },
    { name: "Shadow Weaving", source: "Shadow Priest", kind: "specialist", isCovered: (player) => player.member.className === "Priest" && hasSpec(player, "Shadow") },
  ];

  const planner = document.querySelector<HTMLElement>("[data-raid-planner]");
  const workspace = planner?.querySelector<HTMLElement>("[data-planner-workspace]");
  const loading = planner?.querySelector<HTMLElement>("[data-planner-loading]");
  const teamSwitcher = planner?.querySelector<HTMLElement>("[data-team-switcher]");
  const board = planner?.querySelector<HTMLElement>("[data-raid-frame-board]");
  const inspector = planner?.querySelector<HTMLElement>("[data-member-inspector]");
  const buffPanel = planner?.querySelector<HTMLElement>("[data-buff-panel]");
  const poolList = planner?.querySelector<HTMLElement>("[data-player-pool-list]");
  const poolDropzone = planner?.querySelector<HTMLElement>("[data-player-pool-dropzone]");
  const poolEmpty = planner?.querySelector<HTMLElement>("[data-player-pool-empty]");
  const search = planner?.querySelector<HTMLInputElement>("[data-player-search]");
  const roleFilter = planner?.querySelector<HTMLSelectElement>("[data-player-role-filter]");
  const saveButton = planner?.querySelector<HTMLButtonElement>("[data-save-plan]");
  const reloadButton = planner?.querySelector<HTMLButtonElement>("[data-reload-plan]");
  const status = planner?.querySelector<HTMLElement>("[data-plan-status]");

  let roster: RosterMember[] = [];
  let plan: RaidPlan = { teams: [] };
  let version = 0;
  let updatedAt: string | null = null;
  let dirty = false;
  let saving = false;
  let loaded = false;
  let loadInFlight = false;
  let draggedSlug = "";
  let selectedPoolSlug = "";
  let selectedAssignmentSlug = "";
  let statusMessage = "";
  let activeTeamId: TeamId = "team-a";
  const coverageViews = new Map<TeamId, CoverageView>([["team-a", "20"], ["team-b", "20"]]);

  const setText = (selector: string, value: string | number) => {
    const element = planner?.querySelector<HTMLElement>(selector);
    if (element) element.textContent = String(value);
  };
  const getMember = (slug: string) => roster.find((member) => member.slug === slug);
  const getActiveTeam = () => plan.teams.find((team) => team.id === activeTeamId) ?? plan.teams[0];
  const getTeamForSlug = (slug: string) => plan.teams.find((team) => team.assignments.some((assignment) => assignment.characterSlug === slug));
  const getAssignment = (slug: string) => getTeamForSlug(slug)?.assignments.find((assignment) => assignment.characterSlug === slug);
  const getSubgroup = (group: RaidGroup): Subgroup => group <= 2 ? "A" : "B";
  const getSpecs = (member: RosterMember) => [...new Set([member.specialization, ...(classSpecs[member.className] ?? [])].filter(Boolean))];
  const normalizeRole = (value: string): RaidRole =>
    value === "Tank" || value === "Healer" || value === "Melee DPS" || value === "Ranged DPS" ? value : "Ranged DPS";
  const isTankReady = (assignment: RaidAssignment) => assignment.assignedRole === "Tank" || assignment.offspecTank;
  const isHealerReady = (assignment: RaidAssignment) => assignment.assignedRole === "Healer" || assignment.offspecHealer;

  const formatTimestamp = (value: string | null) => {
    if (!value) return "Not saved yet";
    return `Saved ${new Intl.DateTimeFormat("en-US", {
      month: "short", day: "numeric", hour: "numeric", minute: "2-digit", timeZone: "America/Los_Angeles",
    }).format(new Date(value))} PT`;
  };

  const updateStatus = () => {
    if (!status || !saveButton || !reloadButton) return;
    saveButton.disabled = !loaded || !dirty || saving;
    reloadButton.disabled = !loaded || saving;
    status.textContent = statusMessage || (saving ? "Saving raid plan…" : dirty ? "Unsaved changes" : formatTimestamp(updatedAt));
  };

  const markDirty = () => {
    statusMessage = "";
    dirty = true;
    updateStatus();
  };

  const createButton = (label: string, className: string, onClick: () => void) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = className;
    button.textContent = label;
    button.addEventListener("click", onClick);
    return button;
  };

  const normalizeGroups = () => {
    for (const team of plan.teams) {
      const counts = new Map<RaidGroup, number>(groupNumbers.map((group) => [group, 0]));
      for (const assignment of team.assignments) {
        let group = groupNumbers.includes(assignment.raidGroup) ? assignment.raidGroup : assignment.subgroup === "B" ? 3 : 1;
        if ((counts.get(group) ?? 0) >= 5) group = groupNumbers.find((candidate) => (counts.get(candidate) ?? 0) < 5) ?? 4;
        assignment.raidGroup = group;
        assignment.subgroup = getSubgroup(group);
        counts.set(group, (counts.get(group) ?? 0) + 1);
      }
    }
  };

  const firstOpenGroup = (team: RaidTeam) =>
    groupNumbers.find((group) => team.assignments.filter((assignment) => assignment.raidGroup === group).length < 5);

  const moveToGroup = (slug: string, teamId: TeamId, group: RaidGroup) => {
    const target = plan.teams.find((team) => team.id === teamId);
    const source = getTeamForSlug(slug);
    const member = getMember(slug);
    if (!target || !member || target.locked || source?.locked) return;
    const current = source?.assignments.find((assignment) => assignment.characterSlug === slug);
    const targetCount = target.assignments.filter((assignment) => assignment.raidGroup === group && assignment.characterSlug !== slug).length;
    if (targetCount >= 5 || (!current && target.assignments.length >= 20)) return;

    if (source && source.id !== target.id) source.assignments = source.assignments.filter((assignment) => assignment.characterSlug !== slug);
    const assignment = current ?? {
      characterSlug: slug,
      assignedRole: normalizeRole(member.role),
      assignedSpec: member.specialization || getSpecs(member)[0] || member.className,
      offspecTank: false,
      offspecHealer: false,
      subgroup: getSubgroup(group),
      raidGroup: group,
    };
    assignment.raidGroup = group;
    assignment.subgroup = getSubgroup(group);
    if (!target.assignments.includes(assignment)) target.assignments.push(assignment);
    selectedPoolSlug = "";
    selectedAssignmentSlug = slug;
    markDirty();
    render();
  };

  const addToFirstOpenSlot = (slug: string) => {
    const team = getActiveTeam();
    const group = team && firstOpenGroup(team);
    if (team && group) moveToGroup(slug, team.id, group);
  };

  const removeAssignment = (slug: string) => {
    const team = getTeamForSlug(slug);
    if (!team || team.locked) return;
    team.assignments = team.assignments.filter((assignment) => assignment.characterSlug !== slug);
    selectedAssignmentSlug = "";
    markDirty();
    render();
  };

  const autoArrange = (team: RaidTeam) => {
    if (team.locked) return;
    const ordered = [...team.assignments].sort((left, right) => {
      const priority = (assignment: RaidAssignment) => isTankReady(assignment) ? 0 : isHealerReady(assignment) ? 1 : 2;
      return priority(left) - priority(right) || left.characterSlug.localeCompare(right.characterSlug);
    });
    const groups = groupNumbers.map((group) => ({ group, size: 0, tanks: 0, healers: 0 }));
    for (const assignment of ordered) {
      const candidates = groups.filter((entry) => entry.size < 5);
      candidates.sort((left, right) => {
        if (isTankReady(assignment) && left.tanks !== right.tanks) return left.tanks - right.tanks;
        if (isHealerReady(assignment) && left.healers !== right.healers) return left.healers - right.healers;
        return left.size - right.size || left.group - right.group;
      });
      const target = candidates[0];
      if (!target) continue;
      assignment.raidGroup = target.group;
      assignment.subgroup = getSubgroup(target.group);
      target.size += 1;
      if (isTankReady(assignment)) target.tanks += 1;
      if (isHealerReady(assignment)) target.healers += 1;
    }
    markDirty();
    render();
  };

  const renderTeamSwitcher = () => {
    if (!teamSwitcher) return;
    teamSwitcher.replaceChildren();
    for (const team of plan.teams) {
      const tanks = team.assignments.filter((assignment) => assignment.assignedRole === "Tank").length;
      const healers = team.assignments.filter((assignment) => assignment.assignedRole === "Healer").length;
      const button = createButton("", `raid-team-switch ${team.id === activeTeamId ? "is-active" : ""}`, () => {
        activeTeamId = team.id;
        selectedAssignmentSlug = "";
        selectedPoolSlug = "";
        render();
      });
      const name = document.createElement("strong");
      const summary = document.createElement("span");
      name.textContent = team.name;
      summary.textContent = `${team.assignments.length}/20 · ${tanks}T · ${healers}H`;
      button.append(name, summary);
      button.setAttribute("aria-pressed", String(team.id === activeTeamId));
      teamSwitcher.append(button);
    }
  };

  const createPoolRoleIcon = (role: string) => {
    const kind = role === "Tank" ? "tank" : role === "Healer" ? "healer"
      : role === "Melee DPS" || role === "Ranged DPS" ? "dps" : "unknown";
    const namespace = "http://www.w3.org/2000/svg";
    const icon = document.createElementNS(namespace, "svg");
    const path = document.createElementNS(namespace, "path");
    icon.setAttribute("class", `raid-frame-pool-role is-${kind}`);
    icon.setAttribute("viewBox", "0 0 24 24");
    icon.setAttribute("aria-hidden", "true");
    path.setAttribute("d", poolRoleIcons[kind]);
    icon.append(path);
    return icon;
  };

  const renderPool = () => {
    if (!poolList) return;
    poolList.replaceChildren();
    const assigned = new Set(plan.teams.flatMap((team) => team.assignments.map((assignment) => assignment.characterSlug)));
    const query = search?.value.trim().toLocaleLowerCase() ?? "";
    const selectedRole = roleFilter?.value ?? "all";
    const isSearching = query.length > 0;
    if (roleFilter) roleFilter.disabled = isSearching;
    const visible = roster.filter((member) => {
      if (assigned.has(member.slug)) return false;
      if (isSearching) return member.level >= minimumSearchLevel && member.name.toLocaleLowerCase().includes(query);
      return member.level === levelCap && (selectedRole === "all" || normalizeRole(member.role) === selectedRole);
    });
    if (!visible.some((member) => member.slug === selectedPoolSlug)) selectedPoolSlug = "";
    setText("[data-visible-pool-count]", `${visible.length} ${isSearching ? "matching" : "level 60"}`);

    for (const member of visible) {
      const card = document.createElement("button");
      const name = document.createElement("strong");
      const roleLabel = member.role === "Unknown" ? "Role unknown" : member.role;
      const description = `${member.name} · Level ${member.level} ${member.className} · ${roleLabel}`;
      card.type = "button";
      card.className = "raid-frame-pool-row";
      card.draggable = true;
      card.style.setProperty("--class-color", classColors[member.className] ?? "#7c8cff");
      card.title = description;
      card.setAttribute("aria-label", description);
      const isSelected = selectedPoolSlug === member.slug;
      card.classList.toggle("is-selected", isSelected);
      card.setAttribute("aria-pressed", String(isSelected));
      name.textContent = member.name;
      card.append(name);
      if (member.level < levelCap) {
        const level = document.createElement("span");
        level.className = "raid-frame-pool-level";
        level.textContent = String(member.level);
        card.append(level);
      }
      card.append(createPoolRoleIcon(member.role));
      card.addEventListener("click", (event) => {
        if (event.detail > 1) return;
        // Keep the same card in the DOM so the browser can recognize a double-click.
        const previous = poolList.querySelector(".is-selected");
        previous?.classList.remove("is-selected");
        previous?.setAttribute("aria-pressed", "false");
        const select = selectedPoolSlug !== member.slug;
        selectedPoolSlug = select ? member.slug : "";
        card.classList.toggle("is-selected", select);
        card.setAttribute("aria-pressed", String(select));
        selectedAssignmentSlug = "";
        renderBoard();
        renderInspector();
      });
      card.addEventListener("dblclick", () => addToFirstOpenSlot(member.slug));
      card.addEventListener("dragstart", (event) => {
        event.dataTransfer?.setData("text/plain", member.slug);
        draggedSlug = member.slug;
        card.classList.add("is-dragging");
      });
      card.addEventListener("dragend", () => { draggedSlug = ""; card.classList.remove("is-dragging"); });
      poolList.append(card);
    }
    if (poolEmpty) {
      poolEmpty.hidden = visible.length > 0;
      poolEmpty.textContent = isSearching
        ? "No unassigned characters at level 41 or higher match that name."
        : "No unassigned level 60 players match this role filter.";
    }
  };

  const createRoleMetric = (label: string, value: number, target: number) => {
    const item = document.createElement("span");
    item.className = `raid-frame-role-count ${value >= target ? "is-ready" : "is-short"}`;
    item.textContent = `${value}/${target} ${label}`;
    return item;
  };

  const renderSlot = (team: RaidTeam, group: RaidGroup, assignment?: RaidAssignment) => {
    if (!assignment) {
      const empty = document.createElement("button");
      empty.type = "button";
      empty.className = `raid-frame-slot is-empty ${selectedPoolSlug ? "is-armed" : ""}`;
      empty.textContent = selectedPoolSlug ? `Place ${getMember(selectedPoolSlug)?.name ?? "player"}` : "Empty raid slot";
      empty.disabled = team.locked;
      empty.addEventListener("click", () => { if (selectedPoolSlug) moveToGroup(selectedPoolSlug, team.id, group); });
      empty.addEventListener("dragover", (event) => { if (!team.locked && draggedSlug) event.preventDefault(); });
      empty.addEventListener("drop", (event) => { event.preventDefault(); if (draggedSlug) moveToGroup(draggedSlug, team.id, group); });
      return empty;
    }

    const member = getMember(assignment.characterSlug);
    const row = document.createElement("article");
    const select = document.createElement("button");
    const marker = document.createElement("span");
    const identity = document.createElement("span");
    const name = document.createElement("strong");
    const level = document.createElement("span");
    const role = document.createElement("span");
    const offspec = document.createElement("span");
    const remove = document.createElement("button");
    row.className = `raid-frame-slot is-filled ${selectedAssignmentSlug === assignment.characterSlug ? "is-selected" : ""}`;
    row.draggable = !team.locked;
    row.style.setProperty("--class-color", classColors[member?.className ?? ""] ?? "#7c8cff");
    select.type = "button";
    select.className = "raid-frame-slot-main";
    marker.className = "raid-frame-slot-marker";
    name.textContent = member?.name ?? assignment.characterSlug;
    name.title = name.textContent;
    identity.className = "raid-frame-slot-identity";
    identity.append(name);
    if (member && member.level < levelCap) {
      const warning = document.createElement("span");
      warning.className = "raid-frame-level-warning";
      warning.textContent = "⚠︎";
      warning.title = `Level ${member.level} · Below level ${levelCap}`;
      warning.setAttribute("role", "img");
      warning.setAttribute("aria-label", warning.title);
      identity.append(warning);
    }
    level.textContent = member ? String(member.level) : "—";
    level.className = "raid-frame-slot-level";
    role.className = `raid-frame-slot-role is-${assignment.assignedRole.toLocaleLowerCase().replaceAll(" ", "-")}`;
    role.textContent = roleAbbreviations[assignment.assignedRole];
    role.title = assignment.assignedRole;
    offspec.className = "raid-frame-slot-offspec";
    offspec.textContent = [assignment.offspecTank ? "T-OS" : "", assignment.offspecHealer ? "H-OS" : ""].filter(Boolean).join(" ");
    select.append(marker, identity, level, role, offspec);
    select.addEventListener("click", () => {
      selectedAssignmentSlug = selectedAssignmentSlug === assignment.characterSlug ? "" : assignment.characterSlug;
      selectedPoolSlug = "";
      render();
    });
    remove.type = "button";
    remove.className = "raid-frame-slot-remove";
    remove.textContent = "×";
    remove.title = `Remove ${member?.name ?? assignment.characterSlug}`;
    remove.disabled = team.locked;
    remove.addEventListener("click", () => removeAssignment(assignment.characterSlug));
    row.addEventListener("dragstart", () => { if (!team.locked) { draggedSlug = assignment.characterSlug; row.classList.add("is-dragging"); } });
    row.addEventListener("dragend", () => { draggedSlug = ""; row.classList.remove("is-dragging"); });
    row.append(select, remove);
    return row;
  };

  const renderBoard = () => {
    if (!board) return;
    board.replaceChildren();
    const team = getActiveTeam();
    if (!team) return;
    const header = document.createElement("header");
    const titleWrap = document.createElement("div");
    const eyebrow = document.createElement("span");
    const title = document.createElement("input");
    const actions = document.createElement("div");
    const readiness = document.createElement("div");
    const groups = document.createElement("div");
    header.className = "raid-frame-board-header";
    titleWrap.className = "raid-frame-board-title";
    eyebrow.className = "eyebrow";
    eyebrow.textContent = team.id === "team-a" ? "Team A" : "Team B";
    title.className = "raid-frame-team-name";
    title.value = team.name;
    title.maxLength = 60;
    title.disabled = team.locked;
    title.setAttribute("aria-label", "Raid team name");
    title.addEventListener("change", () => {
      team.name = title.value.trim() || (team.id === "team-a" ? "Raid Team A" : "Raid Team B");
      markDirty();
      render();
    });
    titleWrap.append(eyebrow, title);
    actions.className = "raid-frame-board-actions";
    const arrange = createButton("Arrange groups", "filter-button is-subtle", () => autoArrange(team));
    arrange.disabled = team.locked;
    const lock = createButton(team.locked ? "Unlock raid" : "Lock raid", `filter-button ${team.locked ? "is-locked" : "is-subtle"}`, () => {
      team.locked = !team.locked;
      markDirty();
      render();
    });
    actions.append(arrange, lock);
    header.append(titleWrap, actions);

    const tanks = team.assignments.filter((assignment) => assignment.assignedRole === "Tank").length;
    const healers = team.assignments.filter((assignment) => assignment.assignedRole === "Healer").length;
    const dps = team.assignments.length - tanks - healers;
    const splitA = team.assignments.filter((assignment) => assignment.raidGroup <= 2);
    const splitB = team.assignments.filter((assignment) => assignment.raidGroup >= 3);
    readiness.className = "raid-frame-readiness-bar";
    readiness.append(
      createRoleMetric("players", team.assignments.length, 20),
      createRoleMetric("tanks", tanks, 2),
      createRoleMetric("healers", healers, 4),
      createRoleMetric("DPS", dps, 14),
      createRoleMetric("10A tanks", splitA.filter(isTankReady).length, 2),
      createRoleMetric("10B tanks", splitB.filter(isTankReady).length, 2),
    );

    groups.className = "raid-frame-group-grid";
    for (const group of groupNumbers) {
      const assignments = team.assignments.filter((assignment) => assignment.raidGroup === group);
      const groupCard = document.createElement("section");
      const groupHeader = document.createElement("header");
      const groupTitle = document.createElement("strong");
      const groupMeta = document.createElement("span");
      const slots = document.createElement("div");
      groupCard.className = `raid-frame-group ${group <= 2 ? "is-split-a" : "is-split-b"}`;
      groupHeader.className = "raid-frame-group-header";
      groupTitle.textContent = `Group ${group}`;
      groupMeta.textContent = `${assignments.length}/5 · ${assignments.filter(isTankReady).length}T · ${assignments.filter(isHealerReady).length}H`;
      slots.className = "raid-frame-group-slots";
      groupHeader.append(groupTitle, groupMeta);
      for (let slot = 0; slot < 5; slot += 1) slots.append(renderSlot(team, group, assignments[slot]));
      groupCard.addEventListener("dragover", (event) => { if (!team.locked && draggedSlug && assignments.length < 5) event.preventDefault(); });
      groupCard.addEventListener("drop", (event) => { event.preventDefault(); if (draggedSlug) moveToGroup(draggedSlug, team.id, group); });
      groupCard.append(groupHeader, slots);
      groups.append(groupCard);
    }
    board.append(header, readiness, groups);
  };

  const renderInspector = () => {
    if (!inspector) return;
    inspector.replaceChildren();
    const team = getActiveTeam();
    const assignment = selectedAssignmentSlug ? getAssignment(selectedAssignmentSlug) : undefined;
    const member = assignment && getMember(assignment.characterSlug);
    const heading = document.createElement("div");
    const eyebrow = document.createElement("span");
    const title = document.createElement("h2");
    heading.className = "raid-member-inspector-heading";
    eyebrow.className = "eyebrow";
    eyebrow.textContent = "Selected Raider";
    title.textContent = member?.name ?? "Player details";
    heading.append(eyebrow, title);
    inspector.append(heading);
    if (!team || !assignment || !member || getTeamForSlug(member.slug)?.id !== team.id) {
      const note = document.createElement("p");
      note.className = "info-note";
      note.textContent = "Select a name in the raid frame to edit its role, specialization, off-spec readiness, or group.";
      inspector.append(note);
      return;
    }

    const controls = document.createElement("div");
    controls.className = "raid-member-inspector-controls";
    const addSelect = (labelText: string, values: string[], current: string, onChange: (value: string) => void) => {
      const label = document.createElement("label");
      const labelName = document.createElement("span");
      const select = document.createElement("select");
      label.className = "field";
      labelName.textContent = labelText;
      select.disabled = team.locked;
      for (const value of values) {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = value;
        option.selected = value === current;
        select.append(option);
      }
      select.addEventListener("change", () => { onChange(select.value); markDirty(); render(); });
      label.append(labelName, select);
      controls.append(label);
    };
    addSelect("Raid role", ["Tank", "Healer", "Melee DPS", "Ranged DPS"], assignment.assignedRole, (value) => { assignment.assignedRole = value as RaidRole; });
    addSelect("Specialization", getSpecs(member), assignment.assignedSpec, (value) => { assignment.assignedSpec = value; });
    addSelect("Raid group", groupNumbers.map(String), String(assignment.raidGroup), (value) => {
      const group = Number(value) as RaidGroup;
      if (team.assignments.filter((entry) => entry.raidGroup === group && entry.characterSlug !== assignment.characterSlug).length < 5) {
        assignment.raidGroup = group;
        assignment.subgroup = getSubgroup(group);
      }
    });
    const capabilities = document.createElement("div");
    capabilities.className = "raid-member-capabilities";
    const addCheck = (labelText: string, checked: boolean, enabled: boolean, onChange: (checked: boolean) => void) => {
      if (!enabled) return;
      const label = document.createElement("label");
      const input = document.createElement("input");
      input.type = "checkbox";
      input.checked = checked;
      input.disabled = team.locked;
      input.addEventListener("change", () => { onChange(input.checked); markDirty(); render(); });
      label.append(input, document.createTextNode(labelText));
      capabilities.append(label);
    };
    addCheck("Tank off-spec", assignment.offspecTank, tankClasses.has(member.className), (checked) => { assignment.offspecTank = checked; });
    addCheck("Healer off-spec", assignment.offspecHealer, healerClasses.has(member.className), (checked) => { assignment.offspecHealer = checked; });
    const links = document.createElement("div");
    links.className = "raid-member-inspector-actions";
    const profile = document.createElement("a");
    profile.className = "filter-button is-subtle";
    profile.href = member.profileUrl;
    profile.textContent = "Open profile";
    const remove = createButton("Remove from raid", "filter-button is-danger", () => removeAssignment(member.slug));
    remove.disabled = team.locked;
    links.append(profile, remove);
    inspector.append(controls, capabilities, links);
  };

  const renderBuffs = () => {
    if (!buffPanel) return;
    buffPanel.replaceChildren();
    const team = getActiveTeam();
    if (!team) return;
    const view = coverageViews.get(team.id) ?? "20";
    const players = team.assignments.flatMap((assignment) => {
      if (view === "A" && assignment.raidGroup > 2) return [];
      if (view === "B" && assignment.raidGroup < 3) return [];
      const member = getMember(assignment.characterSlug);
      return member ? [{ member, assignment }] : [];
    });
    const coverage = buffRules.map((rule) => ({ rule, covered: players.some(rule.isCovered) }));
    const heading = document.createElement("div");
    const titleWrap = document.createElement("div");
    const eyebrow = document.createElement("span");
    const title = document.createElement("h2");
    const nav = document.createElement("div");
    const chips = document.createElement("div");
    heading.className = "raid-frame-buff-heading";
    eyebrow.className = "eyebrow";
    eyebrow.textContent = `${coverage.filter((entry) => entry.covered).length}/${coverage.length} covered`;
    title.textContent = "Raid buffs";
    titleWrap.append(eyebrow, title);
    nav.className = "raid-coverage-nav";
    for (const candidate of ["20", "A", "B"] as CoverageView[]) {
      const label = candidate === "20" ? "20-player" : `10-${candidate}`;
      const button = createButton(label, `raid-coverage-tab ${view === candidate ? "is-active" : ""}`, () => {
        coverageViews.set(team.id, candidate);
        renderBuffs();
      });
      nav.append(button);
    }
    heading.append(titleWrap, nav);
    chips.className = "raid-buff-chip-list";
    for (const { rule, covered } of coverage) {
      const chip = document.createElement("span");
      chip.className = `raid-buff-chip ${covered ? "is-covered" : "is-missing"} ${rule.kind === "specialist" ? "is-specialist" : ""}`;
      chip.textContent = rule.name;
      chip.title = covered ? `Covered by ${rule.source}` : `Missing · bring ${rule.source}`;
      chips.append(chip);
    }
    buffPanel.append(heading, chips);
  };

  const render = () => {
    if (!loaded) return;
    renderTeamSwitcher();
    renderPool();
    renderBoard();
    renderInspector();
    renderBuffs();
    const assignments = plan.teams.flatMap((team) => team.assignments);
    const assigned = new Set(assignments.map((assignment) => assignment.characterSlug));
    const maxLevelMembers = roster.filter((member) => member.level === levelCap);
    setText("[data-level-cap-count]", maxLevelMembers.length);
    setText("[data-assigned-count]", assignments.length);
    setText("[data-unassigned-count]", maxLevelMembers.filter((member) => !assigned.has(member.slug)).length);
    setText("[data-tank-ready-count]", assignments.filter(isTankReady).length);
    updateStatus();
  };

  const fetchJson = async <T,>(url: string, init?: RequestInit): Promise<T> => {
    const response = await fetch(url, init);
    const text = await response.text();
    let result: (T & { message?: string }) | undefined;
    try { result = text ? (JSON.parse(text) as T & { message?: string }) : undefined; } catch { result = undefined; }
    if (!response.ok || !result) throw new Error(result?.message ?? "Unable to load raid planner data.");
    return result;
  };

  const loadPlanner = async () => {
    if (!loading || !workspace || loadInFlight) return;
    loadInFlight = true;
    loading.hidden = false;
    loading.textContent = "Loading the guild roster and saved raid plan…";
    workspace.hidden = true;
    loaded = false;
    dirty = false;
    statusMessage = "";
    updateStatus();
    try {
      const [plannerResult, rosterResult] = await Promise.all([
        fetchJson<PlannerResponse>("/api/officer-raid-planner"),
        fetchJson<RosterResponse>("/api/forever-roster"),
      ]);
      plan = plannerResult.plan;
      version = plannerResult.version;
      updatedAt = plannerResult.updatedAt;
      roster = rosterResult.members.sort((left, right) => left.name.localeCompare(right.name));
      normalizeGroups();
      loaded = true;
      loading.hidden = true;
      workspace.hidden = false;
      render();
    } catch (error) {
      loading.textContent = error instanceof Error ? error.message : "Unable to load the raid planner.";
      statusMessage = "Planner unavailable";
      updateStatus();
    } finally {
      loadInFlight = false;
    }
  };

  const savePlan = async () => {
    if (!dirty || saving) return;
    saving = true;
    statusMessage = "";
    updateStatus();
    try {
      const result = await fetchJson<PlannerResponse>("/api/officer-raid-planner", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ version, plan }),
      });
      plan = result.plan;
      version = result.version;
      updatedAt = result.updatedAt;
      dirty = false;
      render();
    } catch (error) {
      statusMessage = error instanceof Error ? error.message : "Unable to save the raid plan.";
    } finally {
      saving = false;
      updateStatus();
    }
  };

  const updatePoolFilter = () => {
    const previousSelection = selectedPoolSlug;
    renderPool();
    if (selectedPoolSlug !== previousSelection) renderBoard();
  };

  search?.addEventListener("input", updatePoolFilter);
  roleFilter?.addEventListener("change", updatePoolFilter);
  saveButton?.addEventListener("click", savePlan);
  reloadButton?.addEventListener("click", loadPlanner);
  poolDropzone?.addEventListener("dragover", (event) => {
    const source = draggedSlug && getTeamForSlug(draggedSlug);
    if (source && !source.locked) { event.preventDefault(); poolDropzone.classList.add("is-drag-over"); }
  });
  poolDropzone?.addEventListener("dragleave", () => poolDropzone.classList.remove("is-drag-over"));
  poolDropzone?.addEventListener("drop", (event) => {
    event.preventDefault();
    poolDropzone.classList.remove("is-drag-over");
    if (draggedSlug) removeAssignment(draggedSlug);
  });
  window.addEventListener("beforeunload", (event) => { if (dirty) event.preventDefault(); });
  window.addEventListener("might:officer-unlocked", loadPlanner);
  window.addEventListener("might:officer-locked", () => { loaded = false; dirty = false; if (workspace) workspace.hidden = true; });
  const officerContent = document.querySelector<HTMLElement>("[data-officer-gated-content]");
  if (officerContent && !officerContent.hidden) void loadPlanner();
</script>
