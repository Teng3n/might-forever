---
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Gear Needs Moved | Might Forever">
  <PageHeader
    eyebrow="Loot"
    title="Gear Needs"
    description="Gear needs moved to the Loot section."
  />

  <section class="panel officer-transition-panel">
    <div class="section-heading">
      <p class="eyebrow">Moved</p>
      <h2>Gear needs moved</h2>
      <p class="info-note">Boss gear needs are now available to the full guild under Loot.</p>
    </div>
    <a class="filter-button is-subtle officer-transition-link" href="/loot/gear-needs">Open Gear Needs</a>
  </section>
</Layout>

<script is:inline>
  window.location.replace("/loot/gear-needs");
</script>
