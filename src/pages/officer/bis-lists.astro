---
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="BiS Lists Moved | Might Forever">
  <PageHeader
    eyebrow="Loot"
    title="BiS Lists"
    description="BiS lists moved to the Loot section."
  />

  <section class="panel officer-transition-panel">
    <div class="section-heading">
      <p class="eyebrow">Moved</p>
      <h2>BiS lists moved</h2>
      <p class="info-note">The BiS lists are now available to the full guild under Loot.</p>
    </div>
    <a class="filter-button is-subtle officer-transition-link" href="/loot/bis-lists">Open BiS Lists</a>
  </section>
</Layout>

<script is:inline>
  window.location.replace("/loot/bis-lists");
</script>
