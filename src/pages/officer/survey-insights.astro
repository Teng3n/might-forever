---
import OfficerGate from "../../components/OfficerGate.astro";
import Layout from "../../layouts/Layout.astro";
import surveyInsights from "../../data/surveyInsights.json";

type Answer = { label: string; count: number };
type Series = { id: string; title: string; answers: Answer[] };

const series = surveyInsights.series as Series[];
const byId = new Map(series.map((item) => [item.id, item]));
const total = surveyInsights.responseCount;
const count = (seriesId: string, label: string) =>
  byId.get(seriesId)?.answers.find((answer) => answer.label === label)?.count ?? 0;
const percent = (value: number, denominator = total) =>
  denominator > 0 ? Math.round((value / denominator) * 100) : 0;

const headlineMetrics = [
  {
    label: "Survey responses",
    value: String(total),
    detail: "Current launch-planning sample",
  },
  {
    label: "Want to raid",
    value: `${percent(count("raidInterest", "Yes"))}%`,
    detail: `${count("raidInterest", "Yes")} yes · ${count("raidInterest", "Undecided")} undecided`,
  },
  {
    label: "Server-flexible",
    value: `${percent(count("serverFlexibility", "Yes") + count("serverFlexibility", "It depends on the selected server"))}%`,
    detail: "Yes or depends on selection",
  },
  {
    label: "Faction-flexible",
    value: `${percent(count("factionFlexibility", "Yes") + count("factionFlexibility", "Possibly"))}%`,
    detail: "Yes or possibly",
  },
];

const sourceUrl = `https://docs.google.com/spreadsheets/d/${surveyInsights.source.spreadsheetId}/edit#gid=352637669`;
---

<Layout title="Survey Insights | Might Forever">
  <OfficerGate>
    <section class="page-header officer-client-heading">
      <p class="eyebrow">Officer · Launch Survey</p>
      <h1>Survey Insights</h1>
      <p>Aggregated decision support from the WoW Forever guild launch survey.</p>
    </section>

    <section class="dashboard-grid survey-headline-grid">
      {
        headlineMetrics.map((metric) => (
          <article class="stat-card">
            <span>{metric.label}</span>
            <strong>{metric.value}</strong>
            <small>{metric.detail}</small>
          </article>
        ))
      }
    </section>

    <section class="panel survey-takeaways">
      <div class="section-heading">
        <p class="eyebrow">Decision snapshot</p>
        <h2>What the current responses suggest</h2>
      </div>
      <ul class="clean-list expectation-list">
        <li><strong>PvP leads server preference:</strong> 15 prefer PvP, while 11 have no preference.</li>
        <li><strong>Faction is comparatively open:</strong> 14 have no preference and 26 would follow or possibly follow a different faction.</li>
        <li><strong>Raid demand is strong:</strong> 25 respondents said yes and the remaining 5 are undecided.</li>
        <li><strong>Role flexibility is valuable:</strong> 8 respondents are willing to fill as needed, matching the 8 who currently prefer melee DPS.</li>
        <li><strong>Early class concentration:</strong> Paladin leads at 6, followed by Druid at 4.</li>
      </ul>
    </section>

    <section class="survey-chart-grid" aria-label="Survey response distributions">
      {
        series.map((item) => (
          <article class="panel survey-chart-card">
            <div class="section-heading">
              <p class="eyebrow">{item.answers.reduce((sum, answer) => sum + answer.count, 0)} selections</p>
              <h2>{item.title}</h2>
            </div>
            <div class="survey-bars">
              {item.answers.map((answer) => {
                const denominator = item.id === "professions" ? total : item.answers.reduce((sum, candidate) => sum + candidate.count, 0);
                const answerPercent = percent(answer.count, denominator);

                const tooltipId = `survey-respondents-${item.id}-${item.answers.indexOf(answer)}`;

                return (
                  <div
                    class="survey-answer"
                    data-survey-answer
                    data-series-id={item.id}
                    data-answer-label={answer.label}
                  >
                    <button
                      class="survey-bar-row survey-answer-trigger"
                      type="button"
                      aria-expanded="false"
                      aria-describedby={tooltipId}
                    >
                      <span class="survey-bar-label">
                        <span>{answer.label}</span>
                        <strong>{answer.count} <small>({answerPercent}%)</small></strong>
                      </span>
                      <span class="survey-bar-track" aria-hidden="true">
                        <span style={`--survey-bar-width: ${answerPercent}%`}></span>
                      </span>
                    </button>
                    <div class="survey-respondent-popover" id={tooltipId} role="tooltip" data-survey-respondents>
                      <p>Loading respondents…</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </article>
        ))
      }
    </section>

    <section class="panel survey-source-panel">
      <div>
        <p class="eyebrow">Source</p>
        <p class="info-note">Last recorded response: {surveyInsights.lastResponseAt}. Discord usernames are loaded only after Officer authentication and are excluded from the public page bundle. Free-text specialization answers remain excluded.</p>
      </div>
      <a class="filter-button is-subtle" href={sourceUrl} target="_blank" rel="noreferrer">Open response sheet</a>
    </section>
  </OfficerGate>
</Layout>

<script>
  type RespondentLookup = Record<string, Record<string, string[]>>;
  type RespondentResponse = {
    ok?: boolean;
    message?: string;
    respondents?: RespondentLookup;
  };

  const surveyAnswers = Array.from(document.querySelectorAll<HTMLElement>("[data-survey-answer]"));
  let respondentLookup: RespondentLookup | undefined;
  let respondentRequest: Promise<void> | undefined;

  const renderRespondents = (answer: HTMLElement, names: string[] | undefined, errorMessage?: string) => {
    const popover = answer.querySelector<HTMLElement>("[data-survey-respondents]");

    if (!popover) {
      return;
    }

    popover.replaceChildren();

    if (errorMessage) {
      const message = document.createElement("p");
      message.textContent = errorMessage;
      popover.append(message);
      return;
    }

    if (!names?.length) {
      const message = document.createElement("p");
      message.textContent = "No respondents recorded for this answer.";
      popover.append(message);
      return;
    }

    const heading = document.createElement("p");
    heading.className = "survey-respondent-heading";
    heading.textContent = `${names.length} ${names.length === 1 ? "respondent" : "respondents"}`;

    const list = document.createElement("ul");
    list.className = "survey-respondent-list";

    for (const name of names) {
      const item = document.createElement("li");
      item.textContent = name;
      list.append(item);
    }

    popover.append(heading, list);
  };

  const populateRespondents = () => {
    for (const answer of surveyAnswers) {
      const seriesId = answer.dataset.seriesId ?? "";
      const answerLabel = answer.dataset.answerLabel ?? "";
      renderRespondents(answer, respondentLookup?.[seriesId]?.[answerLabel]);
    }
  };

  const showRespondentError = (message: string) => {
    for (const answer of surveyAnswers) {
      renderRespondents(answer, undefined, message);
    }
  };

  const loadRespondents = () => {
    if (respondentLookup || respondentRequest) {
      return respondentRequest;
    }

    respondentRequest = (async () => {
      try {
        const response = await fetch("/api/survey-respondents", {
          method: "GET",
          headers: { Accept: "application/json" },
        });
        const result = (await response.json()) as RespondentResponse;

        if (!response.ok || result.ok !== true || !result.respondents) {
          throw new Error(result.message ?? "Respondent details are unavailable.");
        }

        respondentLookup = result.respondents;
        populateRespondents();
      } catch (error) {
        showRespondentError(error instanceof Error ? error.message : "Respondent details are unavailable.");
      } finally {
        respondentRequest = undefined;
      }
    })();

    return respondentRequest;
  };

  const setExpanded = (answer: HTMLElement, expanded: boolean) => {
    answer.dataset.open = expanded ? "true" : "false";
    answer.querySelector<HTMLButtonElement>(".survey-answer-trigger")?.setAttribute("aria-expanded", String(expanded));
  };

  for (const answer of surveyAnswers) {
    const trigger = answer.querySelector<HTMLButtonElement>(".survey-answer-trigger");

    answer.addEventListener("mouseenter", () => {
      void loadRespondents();
      setExpanded(answer, true);
    });
    answer.addEventListener("mouseleave", () => {
      if (answer.dataset.pinned !== "true") {
        setExpanded(answer, false);
      }
    });
    trigger?.addEventListener("focus", () => {
      void loadRespondents();
      setExpanded(answer, true);
    });
    trigger?.addEventListener("blur", () => {
      if (answer.dataset.pinned !== "true") {
        setExpanded(answer, false);
      }
    });
    trigger?.addEventListener("click", () => {
      const nextPinned = answer.dataset.pinned !== "true";

      for (const candidate of surveyAnswers) {
        candidate.dataset.pinned = "false";
        setExpanded(candidate, false);
      }

      answer.dataset.pinned = String(nextPinned);
      setExpanded(answer, nextPinned);
      void loadRespondents();
    });
    trigger?.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        answer.dataset.pinned = "false";
        setExpanded(answer, false);
        trigger.blur();
      }
    });
  }

  document.addEventListener("click", (event) => {
    const eventTarget = event.target;

    if (eventTarget instanceof Node && surveyAnswers.some((answer) => answer.contains(eventTarget))) {
      return;
    }

    for (const answer of surveyAnswers) {
      answer.dataset.pinned = "false";
      setExpanded(answer, false);
    }
  });

  window.addEventListener("might:officer-unlocked", () => {
    void loadRespondents();
  });
</script>
