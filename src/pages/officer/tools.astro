---
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Officer Sync | Might Forever">
  <PageHeader
    eyebrow="Officer"
    title="Officer Sync"
    description="Officer tools moved to the Sync page."
  />

  <section class="panel officer-transition-panel">
    <div class="section-heading">
      <p class="eyebrow">Moved</p>
      <h2>Officer tools moved</h2>
      <p class="info-note">The sync tools now live on the Officer Sync page.</p>
    </div>
    <a class="filter-button is-subtle officer-transition-link" href="/officer/sync">Open Officer Sync</a>
  </section>
</Layout>

<script is:inline>
  window.location.replace("/officer/sync");
</script>
