---
import OfficerGate from "../../components/OfficerGate.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Officer Roster | Might Forever">
  <OfficerGate>
    <section data-officer-roster-root></section>
  </OfficerGate>
</Layout>

<script>
  interface OfficerRosterRow {
    player: string;
    href: string;
    class: string;
    classColor: string;
    spec: string;
    role: string;
    rosterStartDate: string;
    rosterStartLabel: string;
    bench: number;
    bossesIn: number;
    availableBosses: number;
    availableRaidNights: number;
    syncedRaidNights: number;
    out: number;
    late: number;
    mia: number;
  }

  interface OfficerRosterResponse {
    ok?: boolean;
    message?: string;
    totals?: {
      roster: number;
      bench: number;
      bossesIn: number;
      availableBosses: number;
      out: number;
      late: number;
      mia: number;
    };
    rows?: OfficerRosterRow[];
  }

  type SortDirection = "ascending" | "descending";

  const rosterRoot = document.querySelector<HTMLElement>("[data-officer-roster-root]");
  let rosterRendered = false;

  const escapeHtml = (value: string | number) =>
    String(value).replace(/[&<>"']/g, (character) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return entities[character] ?? character;
    });

  const parseJsonResponse = async <T,>(response: Response): Promise<T | undefined> => {
    const responseText = await response.text();

    if (!responseText) {
      return undefined;
    }

    try {
      return JSON.parse(responseText) as T;
    } catch {
      return undefined;
    }
  };
  const pluralize = (count: number, singular: string, plural = `${singular}s`) => (count === 1 ? singular : plural);
  const getBenchDetail = (row: OfficerRosterRow) =>
    `${row.bench} heroic ${pluralize(row.bench, "boss", "bosses")} missed while available. In ${row.bossesIn} / ${row.availableBosses} eligible synced heroic boss kills across ${row.availableRaidNights} / ${row.syncedRaidNights} synced raid nights. Roster eligibility: ${row.rosterStartLabel}.`;

  const compareText = (a: string, b: string) => a.localeCompare(b, undefined, { sensitivity: "base" });

  const getCellValue = (row: HTMLTableRowElement, index: number) => row.cells[index]?.dataset.sortValue ?? "";

  const sortRows = (table: HTMLTableElement, columnIndex: number, sortType: string, direction: SortDirection) => {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.rows);
    const multiplier = direction === "ascending" ? 1 : -1;

    rows.sort((a, b) => {
      const aValue = getCellValue(a, columnIndex);
      const bValue = getCellValue(b, columnIndex);

      if (sortType === "number") {
        const numericDiff = (Number(aValue) || 0) - (Number(bValue) || 0);

        if (numericDiff !== 0) {
          return numericDiff * multiplier;
        }

        return compareText(getCellValue(a, 0), getCellValue(b, 0));
      }

      return compareText(aValue, bValue) * multiplier;
    });

    tbody.append(...rows);
  };

  const bindRosterTable = () => {
    rosterRoot?.querySelectorAll<HTMLTableElement>("[data-sortable-table]").forEach((table) => {
      const headers = Array.from(table.tHead?.rows[0]?.cells ?? []);

      headers.forEach((header, columnIndex) => {
        const button = header.querySelector<HTMLButtonElement>("[data-sort-key]");

        button?.addEventListener("click", () => {
          const currentSort = header.getAttribute("aria-sort");
          const direction: SortDirection =
            currentSort === "ascending"
              ? "descending"
              : currentSort === "descending"
                ? "ascending"
                : button.dataset.sortType === "number"
                  ? "descending"
                  : "ascending";

          headers.forEach((item) => item.removeAttribute("aria-sort"));
          header.setAttribute("aria-sort", direction);
          sortRows(table, columnIndex, button.dataset.sortType ?? "text", direction);
        });
      });
    });
  };

  const renderRoster = (data: OfficerRosterResponse) => {
    if (!rosterRoot || !data.totals || !data.rows) {
      return;
    }

    const rows = data.rows
      .map(
        (row) => `
          <tr style="--class-color: ${escapeHtml(row.classColor)}">
            <td data-label="Player" data-sort-value="${escapeHtml(row.player)}">
              <a class="player-name" href="${escapeHtml(row.href)}" style="--player-color: ${escapeHtml(row.classColor)}" title="${escapeHtml(row.class)}">
                ${escapeHtml(row.player)}
              </a>
            </td>
            <td data-label="Class" data-sort-value="${escapeHtml(row.class)}">${escapeHtml(row.class)}</td>
            <td data-label="Spec" data-sort-value="${escapeHtml(row.spec)}">${escapeHtml(row.spec)}</td>
            <td data-label="Role" data-sort-value="${escapeHtml(row.role)}">${escapeHtml(row.role)}</td>
            <td data-label="Roster Since" data-sort-value="${escapeHtml(row.rosterStartDate || "0000-00-00")}">${escapeHtml(row.rosterStartLabel)}</td>
            <td class="status-count" data-label="Boss Bench" data-sort-value="${row.bench}" title="${escapeHtml(getBenchDetail(row))}">${row.bench}</td>
            <td class="status-count is-wide" data-label="Bosses In" data-sort-value="${row.bossesIn}" title="${escapeHtml(getBenchDetail(row))}">${row.bossesIn} / ${row.availableBosses}</td>
            <td class="status-count" data-label="Out" data-sort-value="${row.out}">${row.out}</td>
            <td class="status-count" data-label="Late" data-sort-value="${row.late}">${row.late}</td>
            <td class="status-count" data-label="MIA" data-sort-value="${row.mia}">${row.mia}</td>
          </tr>
        `,
      )
      .join("");

    rosterRoot.innerHTML = `
      <section class="page-header">
        <p class="eyebrow">Roster</p>
        <h1 class="sr-only">Raid Team</h1>
      </section>

      <section class="dashboard-grid roster-summary-grid">
        <article class="stat-card"><span>Roster Count</span><strong>${data.totals.roster}</strong></article>
        <article class="stat-card"><span>Boss Bench</span><strong>${data.totals.bench}</strong></article>
        <article class="stat-card"><span>Bosses In</span><strong>${data.totals.bossesIn}</strong><small>${data.totals.availableBosses} available</small></article>
        <article class="stat-card"><span>Total Out</span><strong>${data.totals.out}</strong></article>
        <article class="stat-card"><span>Total Late</span><strong>${data.totals.late}</strong></article>
        <article class="stat-card"><span>Total MIA</span><strong>${data.totals.mia}</strong></article>
      </section>

      <section class="panel">
        <div class="table-shell">
          <table class="data-table roster-table officer-roster-table" data-sortable-table="true">
            <thead>
              <tr>
                <th aria-sort="ascending" data-sort-type="text"><button class="sort-button" type="button" data-sort-key="player" data-sort-type="text"><span>Player</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
                <th data-sort-type="text"><button class="sort-button" type="button" data-sort-key="class" data-sort-type="text"><span>Class</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
                <th data-sort-type="text"><button class="sort-button" type="button" data-sort-key="spec" data-sort-type="text"><span>Spec</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
                <th data-sort-type="text"><button class="sort-button" type="button" data-sort-key="role" data-sort-type="text"><span>Role</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
                <th data-sort-type="text"><button class="sort-button" type="button" data-sort-key="rosterStart" data-sort-type="text"><span>Roster Since</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
                <th class="status-count" data-sort-type="number"><button class="sort-button" type="button" data-sort-key="bench" data-sort-type="number"><span>Boss Bench</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
                <th class="status-count is-wide" data-sort-type="number"><button class="sort-button" type="button" data-sort-key="bossesIn" data-sort-type="number"><span>Bosses In</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
                <th class="status-count" data-sort-type="number"><button class="sort-button" type="button" data-sort-key="out" data-sort-type="number"><span>Out</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
                <th class="status-count" data-sort-type="number"><button class="sort-button" type="button" data-sort-key="late" data-sort-type="number"><span>Late</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
                <th class="status-count" data-sort-type="number"><button class="sort-button" type="button" data-sort-key="mia" data-sort-type="number"><span>MIA</span><span class="sort-indicator" aria-hidden="true"></span></button></th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
      </section>
    `;

    bindRosterTable();
  };

  const loadOfficerRoster = async () => {
    if (!rosterRoot || rosterRendered) {
      return;
    }

    rosterRendered = true;
    rosterRoot.innerHTML = `<section class="panel officer-note-panel"><p class="info-note">Loading officer roster...</p></section>`;

    try {
      const response = await fetch("/api/officer-roster");
      const result = await parseJsonResponse<OfficerRosterResponse>(response);

      if (!response.ok || result?.ok !== true) {
        throw new Error(result?.message ?? "Unable to load officer roster.");
      }

      renderRoster(result);
    } catch {
      rosterRoot.innerHTML = `<section class="panel officer-note-panel"><p class="info-note">Unable to load officer roster.</p></section>`;
    }
  };

  window.addEventListener("might:officer-unlocked", loadOfficerRoster);
  window.addEventListener("might:officer-locked", () => {
    rosterRendered = false;

    if (rosterRoot) {
      rosterRoot.innerHTML = "";
    }
  });
</script>
