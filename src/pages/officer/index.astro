---
import OfficerGate from "../../components/OfficerGate.astro";
import Layout from "../../layouts/Layout.astro";

const officerTools = [
  {
    eyebrow: "Launch Survey",
    title: "Survey Insights",
    description: "Review launch interest, server and faction preferences, class demand, roles, and raid intent.",
    href: "/officer/survey-insights",
    action: "Open Insights",
  },
  {
    eyebrow: "Foundation",
    title: "Data Setup",
    description: "Roster, calendar, loot, and progression sources are intentionally not configured yet.",
    href: "/roster",
    action: "View Roster Shell",
  },
];
---

<Layout title="Officer | Might Forever">
  <OfficerGate>
    <section class="page-header officer-client-heading">
      <p class="eyebrow">Officer</p>
      <h1>Planning Tools</h1>
      <p>Private decision support for the Might Forever launch.</p>
    </section>

    <section class="officer-tools-panel-group" aria-label="Officer tools">
      <div class="officer-tools-grid">
        {
          officerTools.map((tool) => (
            <article class="panel officer-tool-card">
              <div class="section-heading">
                <p class="eyebrow">{tool.eyebrow}</p>
                <h2>{tool.title}</h2>
                <p class="info-note">{tool.description}</p>
              </div>
              <div class="officer-tool-actions">
                <a class="filter-button is-subtle" href={tool.href}>{tool.action}</a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </OfficerGate>
</Layout>
