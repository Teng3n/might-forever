---
import Layout from "../../layouts/Layout.astro";
import { siegeOfOrgrimmarBossGuides } from "../../data/siegeOfOrgrimmarGuide";

type RoleKey = "tanks" | "healers" | "dps" | "everyone" | "heroic" | "quick";

type BossGuide = {
  name: string;
  slug: string;
  sections: Record<RoleKey, string[]>;
};

const roleMeta: Record<RoleKey, { label: string; badge: string }> = {
  tanks: { label: "Tanks", badge: "T" },
  healers: { label: "Healers", badge: "H" },
  dps: { label: "DPS", badge: "D" },
  everyone: { label: "Everyone", badge: "All" },
  heroic: { label: "Heroic Differences", badge: "Heroic" },
  quick: { label: "TL;DR Strategy", badge: "TL;DR" },
};

const roleOrder: RoleKey[] = ["tanks", "healers", "dps", "everyone", "heroic", "quick"];

const bossGuides: BossGuide[] = siegeOfOrgrimmarBossGuides;

const getBossCopyText = (boss: BossGuide) =>
  [
    boss.name,
    ...roleOrder.flatMap((role) => {
      const items = boss.sections[role];

      if (items.length === 0) {
        return [];
      }

      return [roleMeta[role].label, ...items.map((item) => `- ${item}`)];
    }),
  ].join("\n");
---

<Layout title="Siege of Orgrimmar Raid Notes | Might Forever">
  <section class="page-header raid-guide-header" id="top">
    <p class="eyebrow">Raid Guides</p>
    <h1>Siege of Orgrimmar</h1>
  </section>

  <div class="raid-guide-scroll-progress" aria-hidden="true">
    <span data-guide-progress></span>
  </div>

  <div class="raid-guide-layout">
    <aside class="panel raid-guide-boss-nav" aria-label="Siege of Orgrimmar boss navigation">
      <div class="raid-guide-nav-heading">
        <p class="eyebrow">Jump To Boss</p>
        <span data-guide-current>1 / {bossGuides.length}</span>
      </div>
      <nav>
        {bossGuides.map((boss, index) => (
          <a href={`#${boss.slug}`} data-boss-nav-link={boss.slug}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {boss.name}
          </a>
        ))}
      </nav>
    </aside>

    <div class="raid-guide-boss-stack">
      {bossGuides.map((boss, index) => (
        <article class="panel raid-guide-boss-card" id={boss.slug} data-boss-section={boss.slug}>
          <header class="raid-guide-boss-header">
            <div>
              <p class="eyebrow">Boss {index + 1}</p>
              <h2>{boss.name}</h2>
            </div>
            <div class="raid-guide-boss-actions">
              <button type="button" class="raid-guide-copy-button" data-copy-notes data-copy-text={getBossCopyText(boss)}>
                Copy notes
              </button>
              <a class="raid-guide-top-link" href="#top">Top</a>
            </div>
          </header>

          <div class="raid-guide-section-grid">
            {roleOrder.map((role) => (
              <section class={`raid-guide-role-card ${role === "heroic" ? "is-heroic" : ""} ${role === "quick" ? "is-quick" : ""}`}>
                <div class="raid-guide-role-heading">
                  <span class="raid-guide-role-badge">{roleMeta[role].badge}</span>
                  <h3>{roleMeta[role].label}</h3>
                </div>
                <ul>
                  {boss.sections[role].map((item) => <li>{item}</li>)}
                </ul>
              </section>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<script>
  const bossSections = Array.from(document.querySelectorAll<HTMLElement>("[data-boss-section]"));
  const bossLinks = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-boss-nav-link]")).map((link) => [
      link.dataset.bossNavLink ?? "",
      link,
    ]),
  );
  const currentBoss = document.querySelector<HTMLElement>("[data-guide-current]");
  const progressBar = document.querySelector<HTMLElement>("[data-guide-progress]");
  const copyButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-copy-notes]"));

  const setActiveBoss = (id: string) => {
    bossLinks.forEach((link, linkId) => {
      link.toggleAttribute("aria-current", linkId === id);
    });

    const index = bossSections.findIndex((section) => section.id === id);

    if (currentBoss && index >= 0) {
      currentBoss.textContent = `${index + 1} / ${bossSections.length}`;
    }
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

      if (visible?.target instanceof HTMLElement) {
        setActiveBoss(visible.target.id);
      }
    },
    {
      rootMargin: "-18% 0px -65% 0px",
      threshold: [0.1, 0.35, 0.6],
    },
  );

  bossSections.forEach((section) => observer.observe(section));

  let ticking = false;
  const updateScrollProgress = () => {
    if (!progressBar) {
      return;
    }

    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
    progressBar.style.transform = `scaleX(${progress})`;
    ticking = false;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateScrollProgress);
        ticking = true;
      }
    },
    { passive: true },
  );
  updateScrollProgress();
  setActiveBoss(bossSections[0]?.id ?? "");

  copyButtons.forEach((button) => {
    const defaultLabel = button.textContent ?? "Copy";

    button.addEventListener("click", async () => {
      const text = button.dataset.copyText ?? "";

      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "Copied";
        button.dataset.state = "success";
      } catch {
        button.textContent = "Copy failed";
        button.dataset.state = "error";
      }

      window.setTimeout(() => {
        button.textContent = defaultLabel;
        button.dataset.state = "";
      }, 1800);
    });
  });
</script>
