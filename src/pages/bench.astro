---
import Layout from "../layouts/Layout.astro";
import OfficerGate from "../components/OfficerGate.astro";
import PageHeader from "../components/PageHeader.astro";
import StatCard from "../components/StatCard.astro";
import { getTodayIso, parseIsoDate, raidNights, type RaidNight, type StatusPlayer } from "../lib/guildData";
import { getPlayerNameStyle } from "../lib/playerStyles";

const BENCH_PAGE_WINDOW_WEEKS = 8;
const getWeekStart = (date: Date) => new Date(date.getFullYear(), date.getMonth(), date.getDate() - date.getDay());
const toIsoDate = (date: Date) =>
  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
const formatShortDate = (isoDate: string) =>
  parseIsoDate(isoDate).toLocaleDateString(undefined, {
    month: "short",
    day: "numeric",
  });
const formatWeekDateRange = (nights: RaidNight[]) => {
  const firstNight = nights[0];
  const lastNight = nights[nights.length - 1];

  if (!firstNight || !lastNight) {
    return "No raid dates";
  }

  if (firstNight.isoDate === lastNight.isoDate) {
    return formatShortDate(firstNight.isoDate);
  }

  return `${formatShortDate(firstNight.isoDate)} - ${formatShortDate(lastNight.isoDate)}`;
};
const sortPlayers = (players: StatusPlayer[]) =>
  [...players].sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: "base" }));
const formatPlayerDetail = (count: number) => `${count} ${count === 1 ? "player" : "players"}`;
const getUniquePlayers = (nights: RaidNight[]) => {
  const playersBySlug = new Map<string, StatusPlayer>();

  for (const night of nights) {
    for (const player of night.bench) {
      playersBySlug.set(player.slug, player);
    }
  }

  return sortPlayers([...playersBySlug.values()]);
};
const getSearchNames = (players: StatusPlayer[]) => players.map((player) => player.name.toLocaleLowerCase()).join(" ");

const todayIso = getTodayIso();
const futureRaidNights = raidNights.filter((night) => night.isoDate >= todayIso);
const weekKeys: string[] = [];

for (const night of futureRaidNights) {
  const weekKey = toIsoDate(getWeekStart(parseIsoDate(night.isoDate)));

  if (!weekKeys.includes(weekKey)) {
    weekKeys.push(weekKey);
  }

  if (weekKeys.length === BENCH_PAGE_WINDOW_WEEKS) {
    break;
  }
}

const benchWeeks = weekKeys.map((weekKey) => {
  const nights = futureRaidNights.filter((night) => toIsoDate(getWeekStart(parseIsoDate(night.isoDate))) === weekKey);
  const uniqueBenchPlayers = getUniquePlayers(nights);

  return {
    weekKey,
    label: formatWeekDateRange(nights),
    nights,
    uniqueBenchPlayers,
    searchNames: getSearchNames(uniqueBenchPlayers),
  };
});
const firstRaidNight = benchWeeks[0]?.nights[0];
const lastWeekWithNights = [...benchWeeks].reverse().find((week) => week.nights.length > 0);
const lastRaidNight = lastWeekWithNights?.nights[lastWeekWithNights.nights.length - 1];
const windowDateRange = firstRaidNight && lastRaidNight
  ? `${formatShortDate(firstRaidNight.isoDate)} - ${formatShortDate(lastRaidNight.isoDate)}`
  : "No raid dates";
const nextBenchWeek = benchWeeks.find((week) => week.uniqueBenchPlayers.length > 0);
const openWeekCount = benchWeeks.filter((week) => week.uniqueBenchPlayers.length === 0).length;
---

<Layout title="Bench | Might Forever">
  <OfficerGate>
    <PageHeader
      eyebrow="Next 8 Weeks Bench Schedule"
      title="Next 8 Weeks Bench Schedule"
    />

    <section class="dashboard-grid compact">
      <StatCard label="Date Range" value={windowDateRange} detail="next 8 weeks" />
      <StatCard
        label="Next Bench"
        value={nextBenchWeek?.label ?? "None"}
        detail={nextBenchWeek ? formatPlayerDetail(nextBenchWeek.uniqueBenchPlayers.length) : "no bench scheduled"}
      />
      <StatCard label="Open Weeks" value={openWeekCount} detail="no bench scheduled" />
    </section>

    <section class="panel bench-search-panel">
      <label class="field bench-search-field">
        <span>Find player</span>
        <input type="search" placeholder="Find player..." data-bench-search />
      </label>

      <p class="info-note bench-search-empty" data-bench-search-empty hidden>
        No bench assignments found for this player in the next 8 weeks.
      </p>
    </section>

    {
      benchWeeks.length > 0 ? (
        <section class="bench-week-stack" data-bench-week-stack>
          {benchWeeks.map((week) => (
            <article
              class={`panel bench-week-card${week.uniqueBenchPlayers.length === 0 ? " is-empty" : ""}`}
              data-bench-week
              data-bench-search-names={week.searchNames}
            >
              <div class="section-heading inline">
                <div>
                  <h2>{week.label}</h2>
                </div>
                <span class="status-pill">{week.uniqueBenchPlayers.length} benched</span>
              </div>

              <section class="bench-week-section compact">
                {week.uniqueBenchPlayers.length > 0 && <h3>Benched</h3>}
                {week.uniqueBenchPlayers.length > 0 ? (
                  <ul class="inline-player-list bench-player-list">
                    {week.uniqueBenchPlayers.map((player) => (
                      <li data-bench-player-name={player.name}>
                        <a class="player-name" href={player.href} style={getPlayerNameStyle(player.name)}>
                          {player.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="info-note">No bench scheduled.</p>
                )}
              </section>
            </article>
          ))}
        </section>
      ) : (
        <section class="panel bench-placeholder">
          <p class="eyebrow">Bench Schedule</p>
          <h2>No upcoming bench schedule</h2>
          <p class="info-note">No future raid nights are currently listed in the calendar data.</p>
        </section>
      )
    }
  </OfficerGate>
</Layout>

<script>
  const normalizeBenchSearch = (value: string) =>
    value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase()
      .trim();

  const benchSearchInput = document.querySelector<HTMLInputElement>("[data-bench-search]");
  const benchWeeks = Array.from(document.querySelectorAll<HTMLElement>("[data-bench-week]"));
  const benchSearchEmpty = document.querySelector<HTMLElement>("[data-bench-search-empty]");

  const updateBenchSearch = () => {
    const query = normalizeBenchSearch(benchSearchInput?.value ?? "");
    let visibleWeeks = 0;

    for (const week of benchWeeks) {
      const weekNames = normalizeBenchSearch(week.dataset.benchSearchNames ?? "");
      const weekMatches = !query || weekNames.includes(query);
      week.hidden = !weekMatches;

      if (weekMatches) {
        visibleWeeks += 1;
      }

      for (const player of Array.from(week.querySelectorAll<HTMLElement>("[data-bench-player-name]"))) {
        const playerMatches = query && normalizeBenchSearch(player.dataset.benchPlayerName ?? "").includes(query);
        player.classList.toggle("is-search-match", Boolean(playerMatches));
      }
    }

    if (benchSearchEmpty) {
      benchSearchEmpty.hidden = query.length === 0 || visibleWeeks > 0;
    }
  };

  benchSearchInput?.addEventListener("input", updateBenchSearch);
  updateBenchSearch();
</script>
