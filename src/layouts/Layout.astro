---
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "Might Forever" } = Astro.props;
type NavChild = {
  href: string;
  label: string;
};

type NavItem = NavChild & {
  matchPrefix?: string;
  children?: NavChild[];
};

const navItems: NavItem[] = [
  { href: "/", label: "Home" },
  { href: "/roster", label: "Roster" },
  {
    href: "/officer",
    label: "Officer",
    matchPrefix: "/officer",
  },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (item: NavItem) => {
  const matchPrefix = item.matchPrefix ?? "";
  return pathname === item.href || (typeof matchPrefix === "string" && matchPrefix.length > 0 && pathname.startsWith(matchPrefix));
};
const isExactActive = (href: string) => pathname === href;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Pre-launch planning hub for the Might Forever World of Warcraft guild."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-frame">
      <aside class="side-nav" aria-label="Guild navigation">
        <a class="side-nav-title" href="/">Might Forever</a>
        <nav>
          {
            navItems.map((item) =>
              item.children ? (
                <div class="side-nav-group" data-active={isActive(item) ? "true" : undefined}>
                  <a class="side-nav-parent" href={item.href}>
                    {item.label}
                  </a>
                  <div class="side-nav-subitems">
                    {item.children.map((child) => (
                      <a href={child.href} aria-current={isExactActive(child.href) ? "page" : undefined}>
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <a href={item.href} aria-current={isActive(item) ? "page" : undefined}>
                  {item.label}
                </a>
              ),
            )
          }
        </nav>
      </aside>

      <div class="site-shell">
        <main>
          <slot />
        </main>
        <footer class="site-footer">
          <span>Might Forever</span>
          <span class="site-footer-sync">Pre-launch foundation</span>
        </footer>
      </div>
    </div>
  </body>
</html>
